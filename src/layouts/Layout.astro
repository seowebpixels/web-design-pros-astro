---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import '../styles/global.css';
import socialLogo from '../assets/wdp-logo-new-design-one.avif';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { 
  title, 
  description = "Web Design Pros - Premier boutique digital agency in Randburg, Johannesburg. We engineer High-Performance Digital Assets for South African growth.",
  canonical
} = Astro.props;

// Match the production sitemap's directory URLs, including for older pages
// that still pass a canonical without a trailing slash.
const canonicalPath = new URL(canonical ?? Astro.url.pathname, Astro.site).pathname;
const canonicalURL = new URL(
  canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`,
  Astro.site
).href;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://webdesignpros.co.za/#website",
      "url": "https://webdesignpros.co.za",
      "name": "Web Design Pros",
      "description": "Boutique digital agency in Randburg, Johannesburg specializing in high-performance web development and digital assets.",
      "publisher": {
        "@id": "https://webdesignpros.co.za/#organization"
      },
      "inLanguage": "en-ZA"
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://webdesignpros.co.za/#organization",
      "name": "Web Design Pros",
      "legalName": "Web Design Pros (Pty) Ltd",
      "url": "https://webdesignpros.co.za",
      "logo": {
        "@type": "ImageObject",
        "@id": "https://webdesignpros.co.za/#logo",
        "url": new URL(socialLogo.src,'https://webdesignpros.co.za').href,
        "caption": "Web Design Pros Logo"
      },
      "image": {
        "@id": "https://webdesignpros.co.za/#logo"
      },
      "description": "Premier boutique digital agency in Randburg, Johannesburg. We specialize in engineering High-Performance Digital Assets for South African Growth.",
      "telephone": "+27752216842",
      "email": "info@webdesignpros.co.za",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "15 Madge Ave",
        "addressLocality": "Northcliff",
        "addressRegion": "Johannesburg",
        "postalCode": "2115",
        "addressCountry": "ZA"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -26.1421358,
        "longitude": 27.9462075
      },
      "hasMap": "https://www.google.com/maps?cid=15746142183424105454",
      "identifier": { "@type": "PropertyValue", "propertyID": "CIPC registration number", "value": "2026/282129/07" },
      "knowsAbout": [
        "Web Design",
        "Web Development",
        "Astro Framework",
        "Search Engine Optimization",
        "Graphic Design",
        "Social Media Marketing"
      ],
      "sameAs": [
        "https://www.facebook.com/profile.php?id=100089762679031",
        "https://www.instagram.com/web_design_pros/",
        "https://www.linkedin.com/in/web-design-pros-a048ba428"
      ],
      "priceRange": "$$"
    }
  ]
};
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="1_D8JYwzEaDv6a4J9fBJwI9Lu7kSK2vCzllSFh58ax8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Web Design Pros" />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://webdesignpros.co.za/social-share.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Web Design Pros" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://webdesignpros.co.za/social-share.png" />

    <!-- Global JSON-LD Schema -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <CustomCursor />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
