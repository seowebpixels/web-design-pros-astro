---
import Header from '../components/Header.astro';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import '../styles/global.css';
import cabinetFont from '../assets/fonts/cabinet-grotesk-variable.woff2?url';
import jakartaFont from '../assets/fonts/plus-jakarta-sans-latin.woff2?url';
import socialLogo from '../assets/wdp-logo-new-design-one.avif';
import { structuredDataForPage, serializeStructuredData } from '../lib/structured-data';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { 
  title, 
  description = "Web Design Pros - Premier boutique digital agency in Randburg, Johannesburg. We engineer High-Performance Digital Assets for South African growth.",
  canonical
} = Astro.props;

// Match the production sitemap's directory URLs, including for older pages
// that still pass a canonical without a trailing slash.
const canonicalPath = new URL(canonical ?? Astro.url.pathname, Astro.site).pathname;
const canonicalURL = new URL(
  canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`,
  Astro.site
).href;

const schemaData = structuredDataForPage(
  canonicalURL,
  new URL(socialLogo.src, 'https://webdesignpros.co.za').href
);
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="1_D8JYwzEaDv6a4J9fBJwI9Lu7kSK2vCzllSFh58ax8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href={cabinetFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Web Design Pros" />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://webdesignpros.co.za/social-share.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Web Design Pros" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://webdesignpros.co.za/social-share.png" />

    <!-- Global JSON-LD Schema -->
    <script type="application/ld+json" is:inline set:html={serializeStructuredData(schemaData)} />
  </head>
  <body>
    <CustomCursor />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
