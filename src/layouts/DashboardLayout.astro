---
interface Props {
  title?: string;
  activeNav?: 'dashboard' | 'services' | 'domains' | 'billing';
  userName?: string;
}

const { 
  title = 'Client Portal - Web Design Pros', 
  activeNav = 'dashboard',
  userName = 'My Account'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <style>
    :root {
      --bg-dark: #001437;
      --bg-card: #001f54;
      --accent-cyan: #00E5FF;
      --text-main: #FFFFFF;
      --text-muted: #94A3B8;
      --border-color: #1E293B;
    }

    body {
      margin: 0;
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: system-ui, -apple-system, sans-serif;
    }

    .nav-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      background-color: #000f2B;
      border-bottom: 1px solid var(--border-color);
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-weight: 500;
      padding-bottom: 0.25rem;
    }

    .nav-links a.active {
      color: var(--accent-cyan);
      border-bottom: 2px solid var(--accent-cyan);
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background-color: var(--bg-card);
      padding: 0.5rem 1rem;
      border-radius: 20px;
      border: 1px solid var(--border-color);
    }

    .container {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 0 1rem;
    }
  </style>
</head>
<body>
  <header class="nav-bar">
    <div class="nav-links">
      <strong style="color: var(--accent-cyan); font-size: 1.2rem; margin-right: 1rem;">Web Design Pros</strong>
      <a href="/dashboard" class={activeNav === 'dashboard' ? 'active' : ''}>Dashboard</a>
      <a href="/dashboard/services" class={activeNav === 'services' ? 'active' : ''}>Services</a>
      <a href="/dashboard/domains" class={activeNav === 'domains' ? 'active' : ''}>Domains</a>
      <a href="/dashboard/billing" class={activeNav === 'billing' ? 'active' : ''}>Billing</a>
    </div>

    <div class="user-pill">
      <span style="width: 10px; height: 10px; background: #10B981; border-radius: 50%;"></span>
      <span style="font-size: 0.9rem;">{userName}</span>
    </div>
  </header>

  <main class="container">
    <slot />
  </main>
</body>
</html>