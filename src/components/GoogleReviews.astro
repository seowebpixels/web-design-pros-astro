---
import {googleReviews,googleReviewSource} from '../data/google-reviews';
const checkedDate=new Intl.DateTimeFormat('en-ZA',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(googleReviewSource.checkedOn+'T12:00:00Z'));
---
<section class="google-reviews" id="google-reviews" data-review-carousel aria-labelledby="google-reviews-heading" aria-roledescription="carousel">
 <div class="reviews-container">
  <header class="reviews-header"><div><p class="reviews-eyebrow">In our clients’ words</p><h2 id="google-reviews-heading">Reviews you can check on Google.</h2><p class="reviews-intro">Feedback from people who have worked with Web Design Pros. Follow the source links to read the original reviews.</p></div><a class="reviews-rating" href={googleReviewSource.url} target="_blank" rel="noopener noreferrer"><span class="rating-value">{googleReviewSource.rating.toFixed(1)}<small> / 5</small></span><span class="review-stars" aria-label="5 out of 5 stars">★★★★★</span><span>{googleReviewSource.count} Google reviews ↗</span></a></header>
  <ol class="reviews-track" id="google-reviews-track" data-reviews-track tabindex="0" aria-label="Customer review excerpts. Use the left and right arrow keys to browse.">
   {googleReviews.map(review=><li class="review-card" data-review-card><article aria-labelledby={`review-${review.id}`}>
    <div class="review-author"><span class="review-avatar" aria-hidden="true">{review.name.split(' ').map(part=>part[0]).slice(0,2).join('').toUpperCase()}</span><div><h3 id={`review-${review.id}`}>{review.name}</h3><p>Published on Google</p></div></div>
    <span class="review-stars" aria-label={`${review.rating} out of 5 stars`}>★★★★★</span>
    <blockquote><p>“{review.quote}”</p></blockquote><span class="review-excerpt-label">Review excerpt</span>
    <a class="review-source" href={review.url??googleReviewSource.url} target="_blank" rel="noopener noreferrer" aria-label={`View Google reviews for Web Design Pros — ${review.name}`}>View on Google ↗</a>
   </article></li>)}
  </ol>
  <div class="reviews-controls" data-review-controls hidden><p class="reviews-position" data-review-position role="status" aria-live="polite" aria-atomic="true">Reviews 1–4 of {googleReviews.length}</p><div><button type="button" data-review-prev aria-label="Show previous reviews" aria-controls="google-reviews-track" disabled>←</button><button type="button" data-review-next aria-label="Show next reviews" aria-controls="google-reviews-track">→</button></div></div>
  <footer class="reviews-footer"><p>Review excerpts and rating checked on <time datetime={googleReviewSource.checkedOn}>{checkedDate}</time>.</p><a href={googleReviewSource.url} target="_blank" rel="noopener noreferrer">Read all {googleReviewSource.count} reviews on Google ↗</a></footer>
 </div>
</section>
<script>
 import '../scripts/google-reviews';
</script>
<style>
 .google-reviews{background:#101b31;border-block:1px solid #34445e;padding:75px 24px;color:#f3f6ff;scroll-margin-top:210px}.reviews-container{max-width:1320px;margin:auto}.reviews-header{display:flex;justify-content:space-between;gap:45px;align-items:center;margin-bottom:34px}.reviews-eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:.75rem;font-weight:600;color:#89cff0;margin-bottom:14px}.reviews-header h2{font-size:clamp(1.9rem,3vw,2.7rem);line-height:1.15;letter-spacing:-.02em;margin-bottom:17px}.reviews-intro{font-size:.95rem;line-height:1.8;color:#bdcce0;max-width:710px}.reviews-rating{display:flex;flex-direction:column;align-items:center;gap:5px;min-width:170px;text-decoration:none;color:#d4e3f3;font-size:.8rem;padding:18px 24px;border:1px solid #405570;border-radius:10px;background:#1b2b43}.rating-value{font-size:2.3rem;font-weight:700;color:white;line-height:1.2}.rating-value small{font-size:1rem;color:#b9cade;font-weight:400}.review-stars{color:#f8c552;font-size:1.05rem;letter-spacing:3px;display:block}.reviews-track{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 60px)/4);gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;list-style:none;margin:0;padding:3px 0 16px;scrollbar-width:thin;scrollbar-color:#607fa5 #1a2a42;overscroll-behavior-x:contain;align-items:stretch}.review-card{scroll-snap-align:start;min-width:0;border:1px solid #3a4d68;border-radius:10px;background:#1c2a43}.review-card article{display:flex;flex-direction:column;height:100%;padding:24px 22px}.review-author{display:flex;align-items:center;gap:12px;min-height:55px}.review-avatar{width:40px;height:40px;flex-shrink:0;display:grid;place-items:center;border-radius:50%;background:#2b4b6c;color:#bce6ff;font-size:.8rem;font-weight:600}.review-author h3{font-size:1rem;font-weight:700;line-height:1.35;overflow-wrap:anywhere;color:#fff}.review-author p{font-size:.68rem;color:#b8c8de;margin-top:4px}.review-card .review-stars{margin-top:21px;font-size:.9rem}.review-card blockquote{margin:17px 0 12px;font-size:.94rem;line-height:1.8;color:#e0e8f3}.review-excerpt-label{font-size:.67rem;color:#b0c2da;margin-bottom:23px}.review-source{margin-top:auto;font-size:.78rem;font-weight:600;color:#89cff0;text-underline-offset:4px}.reviews-controls{display:flex;justify-content:space-between;align-items:center;margin-top:15px;gap:20px}.reviews-controls[hidden]{display:none}.reviews-position{font-size:.8rem;color:#bfd0e4}.reviews-controls>div{display:flex;gap:12px}.reviews-controls button{border:1px solid #6687ac;border-radius:7px;width:46px;height:43px;background:#203853;color:#bde8ff;cursor:pointer;font-size:1.25rem}.reviews-controls button:hover:not(:disabled){background:#2b4b6e}.reviews-controls button:disabled{opacity:.35;cursor:default}.google-reviews a:focus-visible,.google-reviews button:focus-visible,.reviews-track:focus-visible{outline:2px solid #89cff0;outline-offset:3px}.reviews-footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:14px;border-top:1px solid #34465f;margin-top:25px;padding-top:20px;font-size:.75rem;color:#aebfd7}.reviews-footer a{color:#89cff0;text-underline-offset:4px}@media(max-width:1100px){.reviews-track{grid-auto-columns:calc((100% - 20px)/2)}}@media(max-width:600px){.google-reviews{padding:48px 18px;scroll-margin-top:110px}.reviews-header{flex-direction:column;align-items:flex-start;gap:24px}.reviews-rating{align-items:flex-start;min-width:0}.reviews-track{grid-auto-columns:100%}.review-card article{padding:25px}.reviews-controls{margin-top:10px}}
</style>
