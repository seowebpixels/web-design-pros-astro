---
import { Image } from 'astro:assets';
import logoImage from '../assets/wdp-logo-new-design-one.avif';
---

<footer class="site-footer">
  <div class="footer-container">
    
    <!-- Column 1: Brand & Compliance Badges -->
    <div class="footer-col brand-col">
      <a href="/" class="footer-logo-link">
        <Image 
          src={logoImage} 
          alt="Web Design Pros Logo" 
          class="footer-logo"
        />
      </a>
      
      <p class="brand-desc">
        <strong>Web Design Pros</strong> is a premier boutique digital agency in Randburg, Johannesburg. We specialize in engineering High-Performance Digital Assets for South African Growth.
      </p>

      <!-- Clickable Social Media Links -->
      <div class="social-links">
        <a href="https://www.facebook.com/profile.php?id=100089762679031" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/web_design_pros/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/web-design-pros-a048ba428" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
      </div>

      <div class="compliance-badges">
        <p><strong>B-BBEE:</strong> Level 1 Contributor</p>
        <p><strong>CIPC Registered:</strong> 2026/282129/07</p>
        <p><strong>SARS Tax Compliant</strong></p>
      </div>
    </div>

    <!-- Column 2: Quick Links -->
    <div class="footer-col">
      <h3 class="col-title">Quick Links</h3>
      <ul class="footer-links">
        <li><a href="/"><span class="chevron">›</span> Home</a></li>
        <li><a href="/#portfolio"><span class="chevron">›</span> Services Portfolio</a></li>
        <li><a href="/pricing"><span class="chevron">›</span> Get a Quotation</a></li>
        <li><a href="/#contact"><span class="chevron">›</span> Contact Us Directly</a></li>
      </ul>
    </div>

    <!-- Column 3: Our Services -->
    <div class="footer-col">
      <h3 class="col-title">Our Services</h3>
      <ul class="footer-links">
        <li><a href="/#services"><span class="chevron">›</span> Starter Website</a></li>
        <li><a href="/#services"><span class="chevron">›</span> Business Website</a></li>
        <li><a href="/#services"><span class="chevron">›</span> Website Redesign</a></li>
        <li><a href="/#services"><span class="chevron">›</span> Website Maintenance</a></li>
        <li><a href="/#services"><span class="chevron">›</span> Graphic Design</a></li>
        <li><a href="/#services"><span class="chevron">›</span> Social Media Marketing</a></li>
      </ul>
    </div>

    <!-- Column 4: Contact (NAP) & Compliance Downloads -->
    <div class="footer-col">
      <h3 class="col-title">About Us</h3>
      <div class="contact-info">
        <p>📍 15 Madge Avenue, Northcliff, Johannesburg</p>
        <p>📞 <a href="tel:0752216842">075 221 6842</a></p>
        <p>✉️ <a href="mailto:info@webdesignpros.co.za">info@webdesignpros.co.za</a></p>
      </div>

      <h3 class="col-title compliance-title">Compliance</h3>
      <ul class="footer-links">
        <li>
          <a href="/docs/b-bbee-certificate.pdf" download>
            <span class="chevron">›</span> Download B-BBEE Certificate
          </a>
        </li>
        <li>
          <a href="/docs/cipc-registration-certificate.pdf" download>
            <span class="chevron">›</span> Download CIPC Certificate
          </a>
        </li>
        <li>
          <a href="/docs/income-tax-notice-of-registration.pdf" download>
            <span class="chevron">›</span> Download SARS Certificate
          </a>
        </li>
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <p>&copy; {new Date().getFullYear()} Web Design Pros. All Rights Reserved.</p>
      <p class="designer-credit">
        Designed by <a href="/" class="brand-credit-link">Web Design Pros</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #000000;
    color: #ffffff;
    padding-top: 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: inherit;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem 1.5rem;
    display: grid;
    grid-template-columns: 1.2fr 0.9fr 1fr 1.1fr;
    gap: 2.5rem;
  }

  .footer-logo {
    height: 110px;
    width: auto;
    object-fit: contain;
    margin-bottom: 1.25rem;
  }

  .brand-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 1.25rem;
  }

  /* Social Media Styling */
  .social-links {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    align-items: center;
  }

  .social-links a {
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.25s ease, transform 0.25s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .social-links a:hover {
    color: var(--accent-primary, #0096FF);
    transform: translateY(-2px);
  }

  .compliance-badges {
    font-size: 0.825rem;
    color: rgba(255, 255, 255, 0.9);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .col-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .compliance-title {
    margin-top: 1.75rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.25s ease;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .footer-links a:hover {
    color: var(--accent-primary, #0096FF);
  }

  .chevron {
    color: var(--accent-primary, #0096FF);
    font-weight: bold;
  }

  .contact-info {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    line-height: 1.4;
  }

  .contact-info a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }

  .contact-info a:hover {
    color: var(--accent-primary, #0096FF);
  }

  .footer-bottom {
    background-color: #050505;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.25rem 1.5rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-bottom-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .designer-credit {
    margin: 0;
  }

  .brand-credit-link {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-weight: 400;
    transition: font-weight 0.2s ease, color 0.2s ease;
  }

  .brand-credit-link:hover {
    font-weight: 700;
    color: var(--accent-primary, #0096FF);
  }

  /* Responsive Breakdown */
  @media (max-width: 992px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 576px) {
    .footer-container {
      grid-template-columns: 1fr;
    }

    .footer-bottom-container {
      flex-direction: column;
      text-align: center;
    }
  }
</style>