---
import logo1975 from '../assets/branding/1975-ms-disco-logo.avif';
import logo1980 from '../assets/branding/microsoft-1980-heavy-metal-logo.png';
import logo1982 from '../assets/branding/microsoft-1982-blibbet-logo.webp';
import logo1987 from '../assets/branding/microsoft-1987-pacman-logo-1024x768.webp';
import logo2012 from '../assets/branding/ms-2012.avif';
const milestones=[
 {year:'1975',name:'An identity of its time',image:logo1975,alt:'Microsoft’s original 1975 logo with concentric lettering',story:'Microsoft’s debut reflected the visual energy of the 1970s. Concentric lines and rounded lettering gave the young software business a distinctive identity.',lesson:'Trends expire. We balance a contemporary direction with simple, usable design principles, so your identity can develop with your business.'},
 {year:'1980',name:'A sharper direction',image:logo1980,alt:'Microsoft’s angular 1980 wordmark',story:'Sharp angles and diagonal cuts replaced the original rounded lettering. The new wordmark had a much more assertive visual character.',lesson:'Shape sets a mood. We choose curves, edges and letterforms to suit the personality you want your business to communicate.'},
 {year:'1982',name:'One memorable detail',image:logo1982,alt:'Microsoft’s 1982 wordmark with the striped Blibbet O',story:'The striped “O”, nicknamed the Blibbet, gave a straightforward wordmark a recognisable focal point. Microsoft announced this identity in June 1982.',lesson:'Details matter. One distinctive element can help an identity become recognisable without making every part of the design complicated.'},
 {year:'1987',name:'Consistency over decades',image:logo1987,alt:'Microsoft’s italic 1987 wordmark with a cut in the O',story:'The bold italic wordmark and its distinctive cut in the “O” stayed in use for 25 years, until the 2012 redesign.',lesson:'Consistency builds recognition. We design with repeatable usage in mind, from a small website header to a larger printed application.'},
 {year:'2012',name:'A unified visual system',image:logo2012,alt:'Microsoft’s 2012 four-colour symbol and wordmark',story:'A four-colour symbol and a simpler wordmark introduced a new visual direction across Microsoft’s products and communications.',lesson:'A brand is a system. Your website, social templates, email signature and business materials should share a recognisable visual language.'}
];
---
<section class="brand-history" id="brand-history" aria-labelledby="brand-history-heading">
 <div class="history-intro"><p class="history-eyebrow">Brand identity in practice</p><h2 id="brand-history-heading">The evolution of an icon.</h2><p>Microsoft’s logo history shows how an identity can change while building recognition over time. Explore five milestones and the design lessons we apply to a business identity.</p><p class="history-context">An independent design study, not a Web Design Pros client project or a Microsoft endorsement.</p></div>
 <ol class="brand-timeline" aria-label="Microsoft logo timeline, 1975 to 2012">
  {milestones.map(item=><li class="timeline-milestone">
   <span class="timeline-dot" aria-hidden="true"></span>
   <article class="timeline-card" aria-labelledby={`milestone-${item.year}`}>
    <header><span class="timeline-era">Microsoft identity</span><h3 id={`milestone-${item.year}`}><time datetime={item.year}>{item.year}</time></h3><p>{item.name}</p></header>
    <figure class:list={['timeline-logo',{'timeline-colour':item.year==='2012'}]}><img src={item.image.src} width={item.image.width} height={item.image.height} loading="lazy" decoding="async" alt={item.alt} class:list={[{'mono-logo':item.year!=='2012','roomy-logo':item.year==='1987'}]}/></figure>
    <div class="timeline-copy"><h4>The story</h4><p>{item.story}</p><div class="timeline-lesson"><h4>The lesson for your brand</h4><p>{item.lesson}</p></div></div>
   </article>
  </li>)}
 </ol>
 <aside class="history-sources"><h3>Explore the original sources</h3><p>History: <a href="https://news.microsoft.com/microsoft-50/">Microsoft’s anniversary archive</a>, <a href="https://learn.microsoft.com/en-us/shows/history/history-of-microsoft-1982">Microsoft’s 1982 history</a> and <a href="https://blogs.microsoft.com/blog/2012/08/23/microsofts-new-logo-a-brand-for-a-new-era/">the 2012 logo announcement</a>. Design lessons are Web Design Pros’ interpretation. Microsoft names and marks belong to their respective owner.</p></aside>
</section>
<style>
 .brand-history{padding:75px 24px;background:#111c34;border-block:1px solid #354660;color:#f3f7ff}.history-intro,.history-sources{max-width:800px;margin:auto;text-align:center}.history-eyebrow{text-transform:uppercase;letter-spacing:.13em;font-size:.75rem;color:#89cff0;margin-bottom:16px}.history-intro h2{font-size:clamp(2rem,4vw,3rem);line-height:1.15;margin-bottom:22px}.history-intro p:not(.history-eyebrow){color:#becce0;line-height:1.85}.history-intro .history-context{font-size:.76rem;margin-top:15px}.brand-timeline{list-style:none;position:relative;max-width:1050px;margin:55px auto}.brand-timeline:before{content:'';position:absolute;top:0;bottom:0;width:3px;left:calc(50% - 1.5px);background:linear-gradient(#0096ff,#89cff0,#0096ff)}.timeline-milestone{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:68px;padding-bottom:35px}.timeline-milestone:last-child{padding-bottom:0}.timeline-card{grid-column:1;border:1px solid #2a8dd0;border-radius:12px;background:#1b2a45;overflow:hidden;box-shadow:0 12px 30px #0002}.timeline-milestone:nth-child(even) .timeline-card{grid-column:2}.timeline-dot{width:17px;height:17px;background:#89cff0;border:4px solid #111c34;outline:2px solid #0096ff;border-radius:50%;position:absolute;top:38px;left:calc(50% - 8.5px)}.timeline-card:before{content:'';position:absolute;top:45px;left:calc(50% - 34px);width:26px;border-top:2px solid #0096ff}.timeline-milestone:nth-child(even) .timeline-card:before{left:calc(50% + 8px)}.timeline-card header{padding:24px 25px 0}.timeline-era{color:#aebfd8;font-size:.67rem;text-transform:uppercase;letter-spacing:.13em}.timeline-card h3{font-size:2.5rem;font-weight:800;line-height:1.15;margin:6px 0}.timeline-card header p{color:#89cff0;font-size:.9rem}.timeline-logo{height:160px;margin:22px 25px;overflow:hidden;display:flex;align-items:center;justify-content:center}.timeline-logo img{width:100%;height:100%;object-fit:contain}.mono-logo{filter:brightness(0) invert(1)}.timeline-logo .roomy-logo{transform:scale(1.65)}.timeline-colour{background:#f0f4fa;border-radius:6px;padding:20px}.timeline-copy{padding:0 25px 25px}.timeline-copy h4{font-weight:700;font-size:.85rem;color:#e9f5ff;margin-bottom:7px}.timeline-copy p{font-size:.88rem;line-height:1.85;color:#c5d1e3}.timeline-lesson{margin-top:20px;border-top:1px solid #3a506f;padding-top:20px}.timeline-lesson h4{color:#89cff0}.history-sources{border-top:1px solid #3b4e69;padding-top:24px;text-align:left}.history-sources h3{font-size:1rem;font-weight:700;margin-bottom:10px}.history-sources p{font-size:.76rem;line-height:1.9;color:#b8c7df}.history-sources a{color:#89cff0;text-underline-offset:3px}.history-sources a:focus-visible{outline:2px solid #89cff0;outline-offset:4px}
 @media(max-width:680px){.brand-history{padding:48px 18px}.brand-timeline{margin-top:35px}.brand-timeline:before{left:8px}.timeline-milestone{grid-template-columns:minmax(0,1fr);gap:0;padding-left:40px;padding-bottom:26px}.timeline-milestone:nth-child(even) .timeline-card{grid-column:1}.timeline-dot{left:1px}.timeline-card:before,.timeline-milestone:nth-child(even) .timeline-card:before{left:16px;width:24px}.timeline-card header{padding:20px 20px 0}.timeline-copy{padding:0 20px 20px}.timeline-logo{margin:20px;height:140px}.history-intro{text-align:left}}
</style>
