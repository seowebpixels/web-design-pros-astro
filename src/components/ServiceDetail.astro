---
import type {ServiceDetail} from '../data/service-types';
interface Props {detail:ServiceDetail}
const {detail}=Astro.props;
---
<section class="expertise-section" id="our-approach" aria-labelledby="expertise-heading">
 <div class="expertise-intro"><p class="expertise-eyebrow">The thinking behind the work</p><h2 id="expertise-heading">{detail.heading}</h2>{detail.introduction.map(paragraph=><p>{paragraph}</p>)}</div>
 <div class="expertise-body"><div class="expertise-method">{detail.approach.map((item,index)=><article><span class="expertise-number" aria-hidden="true">0{index+1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div><aside class="expertise-outcomes"><h3>What you take forward</h3><ul>{detail.outcomes.map(outcome=><li>{outcome}</li>)}</ul><a href="#contact">Let’s plan your project →</a></aside></div>
 <aside class="expertise-example"><p class="expertise-eyebrow">An example brief</p><h3>{detail.example.title}</h3><p>{detail.example.body}</p></aside>
</section>
<style>
 .expertise-section{width:min(1200px,calc(100% - 48px));margin:auto;padding:65px 0 75px;border-top:1px solid #344660;color:#f1f5ff}.expertise-eyebrow{color:#89cff0;font-size:.75rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;margin-bottom:15px}.expertise-intro{max-width:900px}.expertise-intro h2{font-size:clamp(1.9rem,3.5vw,2.8rem);line-height:1.15;letter-spacing:-.02em;margin-bottom:25px}.expertise-intro>p:not(.expertise-eyebrow){color:#c1cfe2;font-size:1rem;line-height:1.9;margin-bottom:18px}.expertise-body{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(260px,1fr);gap:50px;margin-top:40px;align-items:start}.expertise-method article{display:flex;gap:22px;border-bottom:1px solid #344660;padding-bottom:27px;margin-bottom:27px}.expertise-method article:last-child{border-bottom:0;margin-bottom:0;padding-bottom:0}.expertise-number{color:#89cff0;font-size:.8rem;padding-top:4px}.expertise-section h3{font-size:1.35rem;line-height:1.25;font-weight:700;margin-bottom:13px}.expertise-method p,.expertise-example>p:last-child{color:#becde1;font-size:.92rem;line-height:1.9}.expertise-outcomes{background:#20344f;border-top:3px solid #0096ff;padding:28px;border-radius:8px}.expertise-outcomes ul{list-style:none;margin:20px 0 25px;display:grid;gap:17px}.expertise-outcomes li{position:relative;padding-left:23px;font-size:.9rem;line-height:1.7;color:#d5e2f1}.expertise-outcomes li:before{content:'✓';position:absolute;left:0;color:#89cff0}.expertise-outcomes a{color:#89cff0;font-weight:600;font-size:.88rem;text-underline-offset:4px}.expertise-outcomes a:focus-visible{outline:2px solid #89cff0;outline-offset:5px}.expertise-example{margin-top:40px;padding:26px 30px;background:#101d33;border-left:3px solid #89cff0}.expertise-example h3{font-size:1.2rem}.expertise-example .expertise-eyebrow{font-size:.7rem;margin-bottom:9px}@media(max-width:850px){.expertise-body{grid-template-columns:1fr;gap:30px}.expertise-outcomes{max-width:650px}}@media(max-width:600px){.expertise-section{width:calc(100% - 36px);padding:45px 0}.expertise-body{margin-top:30px}.expertise-method article{gap:14px}.expertise-outcomes,.expertise-example{padding:23px}.expertise-intro>p:not(.expertise-eyebrow){font-size:.94rem}}
</style>
