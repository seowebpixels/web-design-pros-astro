  }

  #growth-form-status:not(:empty) {
    margin: 0 0 20px;
    padding: 16px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    line-height: 1.6;
  }

  /* Keep both columns in normal flow. Only the outer card may scroll on
     small screens; its scrollbar is concealed without clipping controls. */
  .growth-modal, .growth-modal * { box-sizing: border-box; }
  .growth-modal, .growth-modal-card { scrollbar-width: none; }
  .growth-modal::-webkit-scrollbar,
  .growth-modal-card::-webkit-scrollbar { display: none; }
  .growth-modal-card { min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .growth-layout { height: auto; align-items: stretch; }
  .growth-left, .growth-right-column { height: auto; }
  .growth-left > * { flex-shrink: 0; }
  .growth-feature { position: static; margin-top: 20px; }
  .growth-check-title { transform: none; flex-shrink: 0; }
  .growth-panel { overflow: visible; height: auto; transform: none; flex: 1; }
  .growth-step-one { transform: none; padding-top: 26px; }
