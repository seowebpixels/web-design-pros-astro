    .growth-headline { font-size: clamp(36px, 3vw, 58px); margin-bottom: 22px; }
    .growth-indicators { margin-top: 24px; }
    .growth-feature { min-height: 130px; padding: 24px 30px; }
    .growth-select-grid { margin-top: 32px; }
    .growth-step-one .growth-action { padding-top: 30px; }
    .growth-tab { height: 100px; }
  }
  @media (max-width: 1200px) {
    .growth-panel { min-height: 680px; }
  }
  @media (max-width: 700px) {
    .growth-panel { min-height: 0; }
    .growth-success { min-height: 460px; padding: 30px 0; }
  }
</style>



<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

<script>

  document.addEventListener('DOMContentLoaded', () => {

    const modal =
      document.getElementById('growth-modal');

    const closeBtn =
      document.getElementById('close-modal');

    const openBtn =
      document.getElementById('open-growth-modal');

    const btnContinue =
      document.getElementById('btn-continue');

    const step1Content =
      document.getElementById('step-1-content');

    const step2Content =
      document.getElementById('step-2-content');

    const stepLabel =
      document.getElementById('step-label');

    const bar2 =
      document.getElementById('bar-2');

    const tabs =
      document.querySelectorAll('.tab-btn');

    const selects =
      document.querySelectorAll('.growth-select');

    const growthForm =
      document.getElementById('growth-form');

    const growthStatus =
      document.getElementById('growth-form-status');

    const growthSubmitBtn =
      document.getElementById('growth-submit-btn');

    const step1Status =
      document.getElementById('growth-step1-status');

    const growthPanel = modal?.querySelector('.growth-panel');
    const successPanel = document.getElementById('growth-success');
    document.getElementById('growth-success-close')?.addEventListener('click', () => closeBtn?.click());
    let isGrowthSubmitting = false;


    /* =======================================================
       OPEN
       ======================================================= */

    if (openBtn && modal) {

      openBtn.addEventListener('click', () => {

        if (growthPanel?.classList.contains('is-success')) {
          growthPanel.classList.remove('is-success');
          if (successPanel) successPanel.hidden = true;
          resetGrowthModalState();
          growthForm?.classList.remove('hidden');
        }

        if (growthStatus) {
          growthStatus.textContent = '';
          growthStatus.classList.remove('status-error', 'status-success');
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');

        modal.setAttribute('aria-hidden', 'false');

        document.body.style.overflow = 'hidden';

      });

    }


    /* =======================================================
       CLOSE
       ======================================================= */

    if (closeBtn && modal) {

      closeBtn.addEventListener('click', () => {

        modal.classList.add('hidden');
        modal.classList.remove('flex');

        modal.setAttribute('aria-hidden', 'true');

        document.body.style.overflow = '';

      });

    }


    /* =======================================================
       HIGHLIGHT TAB
       ======================================================= */

    function highlightPair(key: string) {

      tabs.forEach(tab => {

        if (tab.getAttribute('data-tab') === key) {

          tab.classList.add('bg-selected');

        } else {

          tab.classList.remove('bg-selected');

        }

      });

    }


    /* =======================================================
       TAB CLICK
       ======================================================= */

    tabs.forEach(tab => {

      tab.addEventListener('click', () => {

        const key =
          tab.getAttribute('data-tab');

        if (key) {

          highlightPair(key);

        }

      });

    });


    /* =======================================================
       SELECT CHANGE
       ======================================================= */

    selects.forEach(select => {

      select.addEventListener('change', () => {

        const targetKey =
          select.getAttribute('data-target');

        if (targetKey) {

          highlightPair(targetKey);

        }

      });

    });


    /* =======================================================
       CONTINUE
       ======================================================= */

    btnContinue?.addEventListener('click', () => {

      const fields = [
        document.getElementById('select-need'),
        document.getElementById('select-goal'),
        document.getElementById('select-plan'),
        document.getElementById('select-budget'),
      ];

      const firstIncomplete = fields.find(
        (field) => !(field instanceof HTMLSelectElement) || !field.value
      );

      if (firstIncomplete) {

        if (step1Status) {
          step1Status.textContent =
            'Please answer all four questions before continuing.';
          step1Status.classList.remove('status-success');
          step1Status.classList.add('status-error');
        }

        if (firstIncomplete instanceof HTMLSelectElement) {
          const targetKey = firstIncomplete.getAttribute('data-target');
          if (targetKey) highlightPair(targetKey);
          firstIncomplete.focus();
        }

        return;

      }

      if (step1Status) {
        step1Status.textContent = '';
        step1Status.classList.remove('status-error', 'status-success');
      }

      step1Content?.classList.add('hidden');

      step2Content?.classList.remove('hidden');

      if (stepLabel) {

        stepLabel.textContent =
          'STEP 2 OF 2';

      }

      if (bar2) {

        bar2.classList.remove('progress-inactive');

        bar2.classList.add('progress-active');

      }

    });


    /* =======================================================
       RESET AFTER CONFIRMED SUCCESS
       ======================================================= */

    function resetGrowthModalState() {

      growthForm instanceof HTMLFormElement && growthForm.reset();

      selects.forEach((select) => {
        if (select instanceof HTMLSelectElement) select.value = '';
      });

      highlightPair('need');

      step2Content?.classList.add('hidden');
      step1Content?.classList.remove('hidden');

      if (stepLabel) stepLabel.textContent = 'STEP 1 OF 2';

      if (bar2) {
        bar2.classList.add('progress-inactive');
        bar2.classList.remove('progress-active');
      }

      if (step1Status) {
        step1Status.textContent = '';
        step1Status.classList.remove('status-error', 'status-success');
      }

    }


    /* =======================================================
       LEAD-CAPTURE SUBMIT
       ======================================================= */

    function setGrowthStatus(message: string, kind: 'error' | 'success') {

      if (!growthStatus) return;

      growthStatus.textContent = message;
      growthStatus.classList.remove('status-error', 'status-success');
      growthStatus.classList.add(kind === 'error' ? 'status-error' : 'status-success');
      growthStatus.setAttribute('role', kind === 'error' ? 'alert' : 'status');
      growthStatus.focus({ preventScroll: true });
      growthStatus.scrollIntoView({ block: 'nearest', behavior: 'auto' });

    }

    function selectedValue(id: string) {

      const element = document.getElementById(id);
      return element instanceof HTMLSelectElement ? element.value : '';

    }

    growthForm?.addEventListener('submit', async (event) => {

      event.preventDefault();
      if (isGrowthSubmitting) return;

      const nameInput = document.getElementById('full-name');
      const emailInput = document.getElementById('email-address');
      const phoneInput = document.getElementById('phone-number');
      const businessInput = document.getElementById('business-name');
      const honeypotInput = document.getElementById('growth-company-site');

      const name = nameInput instanceof HTMLInputElement ? nameInput.value.trim() : '';
      const email = emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
      const phone = phoneInput instanceof HTMLInputElement ? phoneInput.value.trim() : '';
      const business = businessInput instanceof HTMLInputElement ? businessInput.value.trim() : '';
      const website = honeypotInput instanceof HTMLInputElement ? honeypotInput.value : '';

      if (!name) {
        setGrowthStatus('Please tell us your name.', 'error');
        nameInput?.focus();
        return;
      }

      if (!(emailInput instanceof HTMLInputElement) || !emailInput.validity.valid) {
        setGrowthStatus('Please enter a valid email address.', 'error');
        emailInput?.focus();
        return;
      }

      if (!phone) {
        setGrowthStatus('Please enter a phone number.', 'error');
        phoneInput?.focus();
        return;
      }

      const need = selectedValue('select-need');
      const goal = selectedValue('select-goal');
      const timeframe = selectedValue('select-plan');
      const budget = selectedValue('select-budget');

      if (!need || !goal || !timeframe || !budget) {
        setGrowthStatus('Please complete step 1 before submitting.', 'error');
        return;
      }

      isGrowthSubmitting = true;

      if (growthSubmitBtn instanceof HTMLButtonElement) {
        growthSubmitBtn.disabled = true;
        const label = growthSubmitBtn.querySelector('.growth-submit-label');
        if (label) label.textContent = 'Sending…';
      }

      try {

        const response = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            source: 'growth-modal',
            name,
            email,
            phone,
            business,
            need,
            goal,
            timeframe,
            budget,
            website,
          }),
        });

        let result: { ok?: boolean; error?: string } = {};
        try {
          result = await response.json();
        } catch {
          // A non-JSON response is handled as a failed submission below.
        }

        if (response.ok && result && result.ok) {
          growthPanel?.classList.add('is-success');
          if (successPanel) {
            successPanel.hidden = false;
            successPanel.focus({ preventScroll: true });
            successPanel.scrollIntoView({ block: 'nearest' });
          }
        } else {
          setGrowthStatus(
            (result && result.error) ||
              'Something went wrong sending your request. Please try again.',
            'error'
          );
        }

      } catch {

        setGrowthStatus(
          'Something went wrong sending your request. Please check your connection and try again.',
          'error'
        );

      } finally {

        isGrowthSubmitting = false;

        if (growthSubmitBtn instanceof HTMLButtonElement) {
          growthSubmitBtn.disabled = false;
          const label = growthSubmitBtn.querySelector('.growth-submit-label');
          if (label) label.textContent = 'Get my growth plan';
        }

      }

    });

  });

</script>
