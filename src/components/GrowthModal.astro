---
/* GrowthModal.astro */
---

<!-- Trigger Button Below Services Grid -->
<div class="w-full flex justify-center items-center my-14 px-4">
  <button 
    id="open-growth-modal" 
    class="custom-growth-btn font-bold py-4 px-12 text-white text-lg transition duration-300 shadow-xl cursor-pointer text-center block"
    style="background-color: #0096FF; border-radius: 12px !important; width: 100%; max-width: 480px; border: 1px solid rgba(0, 150, 255, 0.4);"
  >
    Find Your Growth Package
  </button>
</div>

<!-- Modal Backdrop -->
<div id="growth-modal" class="fixed inset-0 bg-black/85 backdrop-blur-md hidden z-50 flex items-center justify-center p-4 md:p-8 overflow-y-auto">
  
  <!-- Outer Modal Card -->
  <div 
    class="bg-[#16213E] border border-[#0096FF]/30 text-white w-full max-w-5xl relative shadow-2xl my-auto p-6 md:p-10"
    style="border-radius: 24px !important;"
  >
    
    <!-- Close Button (X) -->
    <button 
      id="close-growth-modal" 
      class="absolute top-5 right-5 bg-[#0f172a] hover:bg-[#0096FF]/20 text-zinc-400 hover:text-white p-2.5 border border-[#0096FF]/30 transition cursor-pointer z-20 flex items-center justify-center"
      style="border-radius: 10px !important;"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      
      <!-- LEFT COLUMN: BRANDING & VALUE PROP -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6 pr-0 lg:pr-2">
        <div class="space-y-6">
          <!-- Top Tag -->
          <div>
            <span 
              class="inline-block bg-[#0f172a] text-[#89CFF0] border border-[#0096FF]/30 text-[11px] font-bold px-3.5 py-1.5 uppercase tracking-wider"
              style="border-radius: 8px !important;"
            >
              📊 BEFORE YOU GO
            </span>
          </div>

          <!-- Logo Header -->
          <div class="text-[#0096FF] font-black text-2xl tracking-wider">
            WEB DESIGN PROS
          </div>

          <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight text-white leading-tight">
            What would help your business grow faster?
          </h2>

          <p class="text-zinc-300 text-sm leading-relaxed">
            Answer a few quick questions and we'll recommend the right web design, SEO, and growth system for your South African business.
          </p>
        </div>

        <!-- 3-Step Feature Badges -->
        <div class="space-y-6 pt-2">
          <div class="grid grid-cols-3 gap-2.5 text-center">
            <div class="bg-[#0f172a] border border-[#0096FF]/25 p-3" style="border-radius: 10px !important;">
              <span class="block text-[10px] font-bold text-[#89CFF0]">01</span>
              <span class="block text-xs font-bold text-white uppercase tracking-wider mt-0.5">GROWTH</span>
            </div>
            <div class="bg-[#0f172a] border border-[#0096FF]/25 p-3" style="border-radius: 10px !important;">
              <span class="block text-[10px] font-bold text-[#89CFF0]">02</span>
              <span class="block text-xs font-bold text-white uppercase tracking-wider mt-0.5">CONVERSION</span>
            </div>
            <div class="bg-[#0f172a] border border-[#0096FF]/25 p-3" style="border-radius: 10px !important;">
              <span class="block text-[10px] font-bold text-[#89CFF0]">03</span>
              <span class="block text-xs font-bold text-white uppercase tracking-wider mt-0.5">FOLLOW-UP</span>
            </div>
          </div>

          <!-- Next Step Callout Box -->
          <div class="bg-[#0f172a]/90 border border-[#0096FF]/30 p-4 flex items-center gap-3.5" style="border-radius: 14px !important;">
            <div class="bg-[#0096FF]/20 text-[#89CFF0] p-2.5 flex-shrink-0" style="border-radius: 10px !important;">
              🚀
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Get a practical next step</h4>
              <p class="text-[11px] text-zinc-400 mt-0.5">No generic pitch — a tailored growth recommendation based on your answers.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: INTERACTIVE FORM CONTAINER -->
      <div 
        class="lg:col-span-7 bg-[#0f172a] border border-[#0096FF]/20 p-6 md:p-8 flex flex-col justify-between"
        style="border-radius: 18px !important;"
      >
        
        <div>
          <!-- Header Bar: Title & Private Badge -->
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-[#89CFF0] tracking-wider uppercase">GROWTH CHECK</span>
            <span 
              class="text-[11px] text-zinc-300 border border-[#0096FF]/30 bg-[#16213E] px-3 py-1 flex items-center gap-1"
              style="border-radius: 6px !important;"
            >
              🔒 Private
            </span>
          </div>
          
          <!-- Progress Bar & Indicator -->
          <p id="step-indicator" class="text-[11px] font-bold text-zinc-300 tracking-wider mb-2 uppercase">STEP 1 OF 2</p>
          <div class="w-full bg-[#16213E] h-2 mb-8 overflow-hidden border border-[#0096FF]/20" style="border-radius: 999px !important;">
            <div id="progress-bar" class="bg-[#0096FF] h-full w-1/2 transition-all duration-300"></div>
          </div>

          <form id="growth-check-form">
            
            <!-- ================= STEP 1: REQUIREMENTS ================= -->
            <div id="modal-step-1" class="space-y-6">
              
              <!-- Tab Navigation Cards -->
              <div class="grid grid-cols-3 gap-3">
                <div class="border-2 border-[#0096FF] bg-[#0096FF]/10 text-white p-3 text-center" style="border-radius: 10px !important;">
                  <span class="block text-xs font-extrabold tracking-wider">NEED</span>
                </div>
                <div class="border border-zinc-800 bg-[#16213E] text-zinc-500 p-3 text-center" style="border-radius: 10px !important;">
                  <span class="block text-xs font-extrabold tracking-wider">GOAL</span>
                </div>
                <div class="border border-zinc-800 bg-[#16213E] text-zinc-500 p-3 text-center" style="border-radius: 10px !important;">
                  <span class="block text-xs font-extrabold tracking-wider">PLAN</span>
                </div>
              </div>

              <!-- Select Field Inputs Grid with Generous Spacing -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-6 pt-2">
                <div>
                  <label class="block text-xs text-zinc-200 font-semibold mb-2">What are you trying to improve?</label>
                  <select 
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 p-3 text-xs text-white focus:border-[#0096FF] focus:outline-none cursor-pointer"
                    style="border-radius: 8px !important;"
                  >
                    <option value="" disabled selected>Select...</option>
                    <option value="website-traffic">Website traffic</option>
                    <option value="lead-generation">Lead generation</option>
                    <option value="online-sales">Online sales</option>
                    <option value="brand-credibility">Brand credibility</option>
                    <option value="google-rankings">Google rankings</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-semibold mb-2">What is your goal?</label>
                  <select 
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 p-3 text-xs text-white focus:border-[#0096FF] focus:outline-none cursor-pointer"
                    style="border-radius: 8px !important;"
                  >
                    <option value="" disabled selected>Select...</option>
                    <option value="more-enquiries">More enquiries</option>
                    <option value="conversion-rate">Higher conversion rate</option>
                    <option value="faster-website">Faster website</option>
                    <option value="seo-visibility">Better SEO visibility</option>
                    <option value="full-redesign">Full redesign</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-semibold mb-2">What is your timeline?</label>
                  <select 
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 p-3 text-xs text-white focus:border-[#0096FF] focus:outline-none cursor-pointer"
                    style="border-radius: 8px !important;"
                  >
                    <option value="" disabled selected>Select...</option>
                    <option value="asap">ASAP (2–4 weeks)</option>
                    <option value="1-2-months">1–2 months</option>
                    <option value="3-plus-months">3+ months</option>
                    <option value="exploring">Just exploring</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-semibold mb-2">What is your budget?</label>
                  <select 
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 p-3 text-xs text-white focus:border-[#0096FF] focus:outline-none cursor-pointer"
                    style="border-radius: 8px !important;"
                  >
                    <option value="" disabled selected>Select...</option>
                    <option value="under-10k">Under R10,000</option>
                    <option value="10k-25k">R10,000 – R25,000</option>
                    <option value="25k-60k">R25,000 – R60,000</option>
                    <option value="60k-plus">R60,000+</option>
                  </select>
                </div>
              </div>

              <!-- Continue Button -->
              <button 
                type="button" 
                id="goto-step-2" 
                class="w-full bg-[#0096FF] hover:bg-[#89CFF0] text-white hover:text-[#16213E] font-bold py-3.5 text-sm transition mt-6 flex items-center justify-center gap-2 cursor-pointer shadow-lg"
                style="border-radius: 10px !important;"
              >
                <span>Continue</span>
                <span>→</span>
              </button>
            </div>

            <!-- ================= STEP 2: CONTACT DETAILS ================= -->
            <div id="modal-step-2" class="space-y-5 hidden">
              <h3 class="text-xl font-bold text-white mb-4">Where should we send your plan?</h3>

              <div class="space-y-4">
                <div>
                  <label class="block text-xs text-zinc-200 font-semibold mb-1.5">Your name</label>
                  <input 
                    type="text" 
                    placeholder="Full name" 
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 p-3 text-xs text-white placeholder-zinc-500 focus:border-[#0096FF] focus:outline-none"
                    style="border-radius: 8px !important;"
                  />
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-semibold mb-1.5">Email address*</label>
                  <input 
                    type="email" 
                    placeholder="you@company.co.za" 
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 p-3 text-xs text-white placeholder-zinc-500 focus:border-[#0096FF] focus:outline-none"
                    style="border-radius: 8px !important;"
                  />
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-semibold mb-1.5">Phone number*</label>
                  <input 
                    type="tel" 
                    placeholder="+27 82 000 0000" 
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 p-3 text-xs text-white placeholder-zinc-500 focus:border-[#0096FF] focus:outline-none"
                    style="border-radius: 8px !important;"
                  />
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-semibold mb-1.5">Business name</label>
                  <input 
                    type="text" 
                    placeholder="Company or brand" 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 p-3 text-xs text-white placeholder-zinc-500 focus:border-[#0096FF] focus:outline-none"
                    style="border-radius: 8px !important;"
                  />
                </div>
              </div>

              <!-- Final Submit Controls -->
              <div class="flex gap-3 pt-3">
                <button 
                  type="button" 
                  id="back-to-step-1" 
                  class="w-1/3 bg-[#16213E] border border-[#0096FF]/40 text-[#89CFF0] font-semibold py-3.5 text-xs transition hover:bg-[#0096FF]/10 cursor-pointer"
                  style="border-radius: 10px !important;"
                >
                  ← Back
                </button>

                <button 
                  type="submit" 
                  class="w-2/3 bg-[#0096FF] hover:bg-[#89CFF0] text-white hover:text-[#16213E] font-bold py-3.5 text-xs transition flex items-center justify-center gap-2 cursor-pointer shadow-lg"
                  style="border-radius: 10px !important;"
                >
                  <span>Get my growth plan</span>
                </button>
              </div>
            </div>

          </form>
        </div>

        <p class="text-[11px] text-zinc-400 text-center mt-6">
          ✨ Better details help us recommend the right growth system.
        </p>

      </div>

    </div>
  </div>
</div>

<style>
  .custom-growth-btn:hover {
    background-color: #89CFF0 !important;
    color: #16213E !important;
  }
</style>

<script is:inline>
  const openBtn = document.getElementById('open-growth-modal');
  const closeBtn = document.getElementById('close-growth-modal');
  const modal = document.getElementById('growth-modal');
  
  const step1 = document.getElementById('modal-step-1');
  const step2 = document.getElementById('modal-step-2');
  const nextBtn = document.getElementById('goto-step-2');
  const backBtn = document.getElementById('back-to-step-1');
  
  const progressBar = document.getElementById('progress-bar');
  const stepIndicator = document.getElementById('step-indicator');

  openBtn?.addEventListener('click', () => modal?.classList.remove('hidden'));
  closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));

  // Step 1 -> Step 2
  nextBtn?.addEventListener('click', () => {
    step1?.classList.add('hidden');
    step2?.classList.remove('hidden');
    progressBar?.classList.replace('w-1/2', 'w-full');
    if (stepIndicator) stepIndicator.textContent = 'STEP 2 OF 2';
  });

  // Step 2 -> Step 1
  backBtn?.addEventListener('click', () => {
    step2?.classList.add('hidden');
    step1?.classList.remove('hidden');
    progressBar?.classList.replace('w-full', 'w-1/2');
    if (stepIndicator) stepIndicator.textContent = 'STEP 1 OF 2';
  });

  // Close on backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.add('hidden');
  });
</script>