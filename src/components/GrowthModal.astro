     JAVASCRIPT
     ========================================================= -->

<script>

  document.addEventListener('DOMContentLoaded', () => {

    const modal =
      document.getElementById('growth-modal');

    const closeBtn =
      document.getElementById('close-modal');

    const openBtn =
      document.getElementById('open-growth-modal');

    const btnContinue =
      document.getElementById('btn-continue');

    const step1Content =
      document.getElementById('step-1-content');

    const step2Content =
      document.getElementById('step-2-content');

    const stepLabel =
      document.getElementById('step-label');

    const bar2 =
      document.getElementById('bar-2');

    const tabs =
      document.querySelectorAll('.tab-btn');

    const selects =
      document.querySelectorAll('.growth-select');


    /* =======================================================
       OPEN
       ======================================================= */

    if (openBtn && modal) {

      openBtn.addEventListener('click', () => {

        modal.classList.remove('hidden');
        modal.classList.add('flex');

        modal.setAttribute('aria-hidden', 'false');

        document.body.style.overflow = 'hidden';

      });

    }


    /* =======================================================
       CLOSE
       ======================================================= */

    if (closeBtn && modal) {

      closeBtn.addEventListener('click', () => {

        modal.classList.add('hidden');
        modal.classList.remove('flex');

        modal.setAttribute('aria-hidden', 'true');

        document.body.style.overflow = '';

      });

    }


    /* =======================================================
       HIGHLIGHT TAB
       ======================================================= */

    function highlightPair(key) {

      tabs.forEach(tab => {

        if (tab.getAttribute('data-tab') === key) {

          tab.classList.add('bg-selected');

        } else {

          tab.classList.remove('bg-selected');

        }

      });

    }


    /* =======================================================
       TAB CLICK
       ======================================================= */

    tabs.forEach(tab => {

      tab.addEventListener('click', () => {

        const key =
          tab.getAttribute('data-tab');

        if (key) {

          highlightPair(key);

        }

      });

    });


    /* =======================================================
       SELECT CHANGE
       ======================================================= */

    selects.forEach(select => {

      select.addEventListener('change', () => {

        const targetKey =
          select.getAttribute('data-target');

        if (targetKey) {

          highlightPair(targetKey);

        }

      });

    });


    /* =======================================================
       CONTINUE
       ======================================================= */

    btnContinue?.addEventListener('click', () => {

      step1Content?.classList.add('hidden');

      step2Content?.classList.remove('hidden');

      if (stepLabel) {

        stepLabel.textContent =
          'STEP 2 OF 2';

      }

      if (bar2) {

        bar2.classList.remove('progress-inactive');

        bar2.classList.add('progress-active');

      }

    });

  });

</script>