---
/* GrowthModal.astro */
---

<!-- Trigger Button (Item 13: Matches button_3.png exactly) -->
<div class="w-full flex justify-center items-center my-12 px-4">
  <button 
    id="open-growth-modal" 
    type="button"
    class="font-semibold text-white text-base py-3.5 px-7 transition-all duration-200 shadow-md hover:opacity-90 cursor-pointer text-center inline-flex items-center justify-center rounded-xl"
    style="background-color: #3b82f6;"
  >
    Find Your Growth Package
  </button>
</div>

<!-- Modal Backdrop (Item 7: Expanded max width to max-w-6xl and increased padding) -->
<div id="growth-modal" class="fixed inset-0 bg-black/80 backdrop-blur-md hidden z-50 flex items-center justify-center p-4 md:p-8 overflow-y-auto">
  
  <!-- Main Modal Container -->
  <div class="bg-[#16213E] text-white w-full max-w-6xl rounded-2xl p-8 md:p-12 shadow-2xl my-auto">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
      
      <!-- LEFT COLUMN (Item 9 & 10: Alignment & 30px offsets) -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-8 pl-0 lg:pl-[30px]">
        <div class="space-y-6">
          <!-- Item 9: BEFORE YOU GO centered in its badge wrapper -->
          <div class="flex justify-center lg:justify-start">
            <span class="inline-flex items-center justify-center gap-2 bg-[#0f172a] border border-[#0096FF]/30 text-[#89CFF0] text-xs font-bold px-4 py-2 rounded-lg uppercase tracking-wider text-center">
              <span>📊</span> BEFORE YOU GO
            </span>
          </div>

          <!-- Title & Description -->
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white leading-tight">
            What would help your business grow faster?
          </h2>

          <p class="text-zinc-300 text-sm leading-relaxed">
            Answer a few quick questions and we&apos;ll recommend the right web design, SEO, and growth system for your South African business.
          </p>
        </div>

        <div class="space-y-8">
          <!-- Item 11: GROWTH, CONVERSION, FOLLOW-UP boxes twice as big, text dead center -->
          <div class="grid grid-cols-3 gap-4 text-center">
            <div class="bg-[#0f172a] border border-[#0096FF]/20 p-6 rounded-xl flex flex-col items-center justify-center min-h-[90px]">
              <span class="block text-sm font-bold text-[#89CFF0]">01</span>
              <span class="block text-xs font-bold text-white uppercase mt-1 tracking-wider text-center">GROWTH</span>
            </div>
            <div class="bg-[#0f172a] border border-[#0096FF]/20 p-6 rounded-xl flex flex-col items-center justify-center min-h-[90px]">
              <span class="block text-sm font-bold text-[#89CFF0]">02</span>
              <span class="block text-xs font-bold text-white uppercase mt-1 tracking-wider text-center">CONVERSION</span>
            </div>
            <div class="bg-[#0f172a] border border-[#0096FF]/20 p-6 rounded-xl flex flex-col items-center justify-center min-h-[90px]">
              <span class="block text-sm font-bold text-[#89CFF0]">03</span>
              <span class="block text-xs font-bold text-white uppercase mt-1 tracking-wider text-center">FOLLOW-UP</span>
            </div>
          </div>

          <!-- Item 12: Dropped 30px (mt-[30px]) -->
          <div class="bg-[#0f172a] border border-[#0096FF]/20 p-5 rounded-xl flex items-center gap-4 mt-[30px]">
            <div class="bg-[#0096FF]/20 text-[#89CFF0] p-3 rounded-lg flex-shrink-0 text-xl">
              🚀
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Get a practical next step</h4>
              <p class="text-xs text-zinc-400 mt-1">No generic pitch — a tailored growth recommendation based on your answers.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: FLOATING FORM CARD (Item 8, 10: 30px padding around edges) -->
      <div class="lg:col-span-7 bg-[#0f172a] border border-[#0096FF]/30 p-[30px] rounded-2xl relative shadow-xl flex flex-col justify-between">
        
        <!-- Close Button -->
        <button 
          id="close-growth-modal" 
          type="button"
          class="absolute top-6 right-6 bg-[#16213E] hover:bg-[#0096FF]/20 text-zinc-300 hover:text-white w-9 h-9 rounded-full border border-[#0096FF]/30 transition cursor-pointer flex items-center justify-center z-20"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>

        <div>
          <!-- Item 1: Center align the words GROWTH CHECK -->
          <div class="mb-3 text-center">
            <span class="text-xs font-bold text-[#89CFF0] tracking-wider uppercase block">GROWTH CHECK</span>
          </div>
          
          <!-- Progress Bar -->
          <p id="step-indicator" class="text-[10px] font-bold text-zinc-400 tracking-wider mb-2 uppercase text-center">STEP 1 OF 2</p>
          <div class="w-full bg-[#16213E] h-2 overflow-hidden rounded-full border border-[#0096FF]/20">
            <div id="progress-bar" class="bg-[#0096FF] h-full w-1/2 transition-all duration-300"></div>
          </div>

          <form id="growth-check-form" name="growth-calculator" method="POST" data-netlify="true">
            <input type="hidden" name="form-name" value="growth-calculator" />
            
            <!-- STEP 1 -->
            <div id="modal-step-1">
              
              <!-- Item 2: Dropped 30px lower (mt-[30px]), 25% larger boxes, dead-center contents, rounded-2xl like wdp-7.png -->
              <div class="grid grid-cols-3 gap-4 mt-[30px]">
                <div class="border-2 border-[#0096FF] bg-[#0096FF]/15 text-white p-6 text-center rounded-2xl flex flex-col items-center justify-center gap-2 cursor-pointer min-h-[110px]">
                  <span class="text-2xl block text-center">🎯</span>
                  <span class="block text-xs font-bold tracking-wider uppercase text-center w-full">NEED</span>
                </div>
                <div class="border border-zinc-800 bg-[#16213E] text-zinc-400 p-6 text-center rounded-2xl flex flex-col items-center justify-center gap-2 cursor-pointer hover:border-[#0096FF]/40 min-h-[110px]">
                  <span class="text-2xl block text-center">📈</span>
                  <span class="block text-xs font-bold tracking-wider uppercase text-center w-full">GOAL</span>
                </div>
                <div class="border border-zinc-800 bg-[#16213E] text-zinc-400 p-6 text-center rounded-2xl flex flex-col items-center justify-center gap-2 cursor-pointer hover:border-[#0096FF]/40 min-h-[110px]">
                  <span class="text-2xl block text-center">🛡️</span>
                  <span class="block text-xs font-bold tracking-wider uppercase text-center w-full">PLAN</span>
                </div>
              </div>

              <!-- Item 3: Dropped 30px lower (mt-[30px]) -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6 mt-[30px]">
                <div>
                  <label class="block text-xs text-zinc-200 font-medium mb-2">What are you trying to improve?</label>
                  <!-- Item 4: 3x taller select box, non-pill wdp-7 style (py-5, rounded-2xl) -->
                  <select 
                    name="improvement_area"
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 py-5 px-5 text-sm text-white rounded-2xl focus:border-[#0096FF] focus:outline-none cursor-pointer appearance-none"
                  >
                    <option value="" disabled selected>Select...</option>
                    <option value="website-traffic">Website traffic</option>
                    <option value="lead-generation">Lead generation</option>
                    <option value="online-sales">Online sales</option>
                    <option value="brand-credibility">Brand credibility</option>
                    <option value="google-rankings">Google rankings</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-medium mb-2">What is your goal?</label>
                  <select 
                    name="goal"
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 py-5 px-5 text-sm text-white rounded-2xl focus:border-[#0096FF] focus:outline-none cursor-pointer appearance-none"
                  >
                    <option value="" disabled selected>Select...</option>
                    <option value="more-enquiries">More enquiries</option>
                    <option value="conversion-rate">Higher conversion rate</option>
                    <option value="faster-website">Faster website</option>
                    <option value="seo-visibility">Better SEO visibility</option>
                    <option value="full-redesign">Full redesign</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-medium mb-2">What is your timeline?</label>
                  <select 
                    name="timeline"
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 py-5 px-5 text-sm text-white rounded-2xl focus:border-[#0096FF] focus:outline-none cursor-pointer appearance-none"
                  >
                    <option value="" disabled selected>Select...</option>
                    <option value="asap">ASAP (2–4 weeks)</option>
                    <option value="1-2-months">1–2 months</option>
                    <option value="3-plus-months">3+ months</option>
                    <option value="exploring">Just exploring</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-medium mb-2">What is your budget?</label>
                  <select 
                    name="budget"
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 py-5 px-5 text-sm text-white rounded-2xl focus:border-[#0096FF] focus:outline-none cursor-pointer appearance-none"
                  >
                    <option value="" disabled selected>Select...</option>
                    <option value="under-10k">Under R10,000</option>
                    <option value="10k-25k">R10,000 – R25,000</option>
                    <option value="25k-60k">R25,000 – R60,000</option>
                    <option value="60k-plus">R60,000+</option>
                  </select>
                </div>
              </div>

              <!-- Item 5: Continue button narrower (w-2/3 mx-auto) and dropped 30px (mt-[30px]) -->
              <div class="mt-[30px] flex justify-center">
                <button 
                  type="button" 
                  id="goto-step-2" 
                  class="w-2/3 bg-[#0096FF] hover:bg-[#89CFF0] text-white hover:text-[#16213E] font-bold py-4 text-sm transition flex items-center justify-center gap-2 rounded-xl cursor-pointer shadow-lg"
                >
                  <span>Continue</span>
                  <span>→</span>
                </button>
              </div>
            </div>

            <!-- STEP 2 -->
            <div id="modal-step-2" class="space-y-5 hidden mt-[30px]">
              <h3 class="text-xl font-bold text-white mb-4">Where should we send your plan?</h3>

              <div class="space-y-4">
                <div>
                  <label class="block text-xs text-zinc-200 font-medium mb-2">Your name</label>
                  <input 
                    type="text" 
                    name="full_name"
                    placeholder="Full name" 
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 py-5 px-5 text-sm text-white placeholder-zinc-500 rounded-2xl focus:border-[#0096FF] focus:outline-none"
                  />
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-medium mb-2">Email address*</label>
                  <input 
                    type="email" 
                    name="email"
                    placeholder="you@company.co.za" 
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 py-5 px-5 text-sm text-white placeholder-zinc-500 rounded-2xl focus:border-[#0096FF] focus:outline-none"
                  />
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-medium mb-2">Phone number*</label>
                  <input 
                    type="tel" 
                    name="phone"
                    placeholder="+27 82 000 0000" 
                    required 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 py-5 px-5 text-sm text-white placeholder-zinc-500 rounded-2xl focus:border-[#0096FF] focus:outline-none"
                  />
                </div>

                <div>
                  <label class="block text-xs text-zinc-200 font-medium mb-2">Business name</label>
                  <input 
                    type="text" 
                    name="business_name"
                    placeholder="Company or brand" 
                    class="w-full bg-[#16213E] border border-[#0096FF]/40 py-5 px-5 text-sm text-white placeholder-zinc-500 rounded-2xl focus:border-[#0096FF] focus:outline-none"
                  />
                </div>
              </div>

              <div class="flex gap-3 pt-3">
                <button 
                  type="button" 
                  id="back-to-step-1" 
                  class="w-1/3 bg-[#16213E] border border-[#0096FF]/40 text-[#89CFF0] font-semibold py-4 text-xs transition hover:bg-[#0096FF]/20 rounded-xl cursor-pointer"
                >
                  ← Back
                </button>

                <button 
                  type="submit" 
                  class="w-2/3 bg-[#0096FF] hover:bg-[#89CFF0] text-white hover:text-[#16213E] font-bold py-4 text-xs transition rounded-xl flex items-center justify-center gap-2 cursor-pointer shadow-lg"
                >
                  <span>Get my growth plan</span>
                </button>
              </div>
            </div>

          </form>
        </div>

        <!-- Item 6: Footer note dropped 30px lower (mt-[30px]) -->
        <p class="text-[11px] text-zinc-400 text-center mt-[30px] flex items-center justify-center gap-1">
          <span>✨</span> Better details help us recommend the right growth system.
        </p>

      </div>

    </div>
  </div>
</div>

<script is:inline>
  const openBtn = document.getElementById('open-growth-modal');
  const closeBtn = document.getElementById('close-growth-modal');
  const modal = document.getElementById('growth-modal');
  
  const step1 = document.getElementById('modal-step-1');
  const step2 = document.getElementById('modal-step-2');
  const nextBtn = document.getElementById('goto-step-2');
  const backBtn = document.getElementById('back-to-step-1');
  
  const progressBar = document.getElementById('progress-bar');
  const stepIndicator = document.getElementById('step-indicator');

  openBtn?.addEventListener('click', () => modal?.classList.remove('hidden'));
  closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));

  nextBtn?.addEventListener('click', () => {
    step1?.classList.add('hidden');
    step2?.classList.remove('hidden');
    progressBar?.classList.replace('w-1/2', 'w-full');
    if (stepIndicator) stepIndicator.textContent = 'STEP 2 OF 2';
  });

  backBtn?.addEventListener('click', () => {
    step2?.classList.add('hidden');
    step1?.classList.remove('hidden');
    progressBar?.classList.replace('w-full', 'w-1/2');
    if (stepIndicator) stepIndicator.textContent = 'STEP 1 OF 2';
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.add('hidden');
  });
</script>