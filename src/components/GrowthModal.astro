---
/* GrowthModal.astro */
---

<!-- Trigger Button Below Services Grid -->
<div class="text-center my-10">
  <button 
    id="open-growth-modal" 
    class="bg-[#0096FF] hover:bg-[#89CFF0] text-white hover:text-[#16213E] font-bold py-4 px-8 rounded-xl transition duration-300 shadow-lg cursor-pointer text-lg flex items-center justify-center gap-2 mx-auto"
  >
    <span>🚀 Find Your Growth Package</span>
  </button>
</div>

<!-- Modal Backdrop -->
<div id="growth-modal" class="fixed inset-0 bg-black/80 backdrop-blur-md hidden z-50 flex items-center justify-center p-4">
  <!-- Modal Card -->
  <div class="bg-[#16213E] border border-[#0096FF]/30 text-white rounded-2xl max-w-4xl w-full p-6 md:p-10 relative shadow-2xl overflow-hidden">
    
    <!-- Close Button -->
    <button id="close-growth-modal" class="absolute top-6 right-6 bg-[#0f172a] hover:bg-[#0096FF]/20 text-zinc-400 hover:text-[#89CFF0] rounded-full p-2 border border-[#0096FF]/20 transition">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Column: Context Branding -->
      <div class="lg:col-span-5 space-y-6">
        <span class="inline-block bg-[#0f172a] text-[#89CFF0] border border-[#0096FF]/30 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
          📊 Before You Go
        </span>
        
        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight">
          What would help your business grow faster?
        </h2>
        <p class="text-zinc-300 text-sm leading-relaxed">
          Answer a few quick questions and we'll recommend the right web design, SEO, and growth system for your South African business.
        </p>

        <!-- Feature Steps Indicators -->
        <div class="grid grid-cols-3 gap-2 text-center text-[10px] font-bold uppercase tracking-wider">
          <div class="bg-[#0f172a] border border-[#0096FF]/30 text-[#89CFF0] p-2 rounded-lg">01 Growth</div>
          <div class="bg-[#0f172a] border border-[#0096FF]/30 text-[#89CFF0] p-2 rounded-lg">02 Conversion</div>
          <div class="bg-[#0f172a] border border-[#0096FF]/30 text-[#89CFF0] p-2 rounded-lg">03 Follow-Up</div>
        </div>

        <div class="bg-[#0f172a]/80 border border-[#0096FF]/20 p-4 rounded-xl flex items-start gap-3">
          <div class="bg-[#0096FF]/20 text-[#89CFF0] p-2 rounded-lg">🚀</div>
          <div>
            <h4 class="text-sm font-semibold text-white">Get a practical next step</h4>
            <p class="text-xs text-zinc-400">No generic pitch — a tailored growth recommendation based on your answers.</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7 bg-[#0f172a] border border-[#0096FF]/20 p-6 md:p-8 rounded-xl shadow-inner">
        
        <!-- Header & Privacy Badge -->
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-[#89CFF0] tracking-wider uppercase">Growth Check</span>
          <span class="text-xs text-zinc-400 border border-[#0096FF]/20 bg-[#16213E] px-2 py-0.5 rounded">🔒 Private</span>
        </div>
        
        <!-- Dynamic Progress Bar -->
        <p id="step-indicator" class="text-xs text-[#89CFF0] font-medium mb-1">STEP 1 OF 2</p>
        <div class="w-full bg-[#16213E] h-1.5 rounded-full mb-6 overflow-hidden border border-[#0096FF]/20">
          <div id="progress-bar" class="bg-[#0096FF] h-full w-1/2 transition-all duration-300"></div>
        </div>

        <form id="growth-check-form" class="space-y-4">
          
          <!-- STEP 1: REQUIREMENTS -->
          <div id="modal-step-1" class="space-y-4">
            
            <!-- Category Tabs -->
            <div class="grid grid-cols-3 gap-2 mb-4">
              <div class="border border-[#0096FF] bg-[#0096FF]/10 text-[#89CFF0] rounded-lg p-2.5 text-center">
                <span class="block text-xs font-bold">NEED</span>
              </div>
              <div class="border border-zinc-800 bg-[#16213E] text-zinc-500 rounded-lg p-2.5 text-center">
                <span class="block text-xs font-bold">GOAL</span>
              </div>
              <div class="border border-zinc-800 bg-[#16213E] text-zinc-500 rounded-lg p-2.5 text-center">
                <span class="block text-xs font-bold">PLAN</span>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs text-zinc-300 font-medium mb-1">What are you trying to improve?</label>
                <select required class="w-full bg-[#16213E] border border-[#0096FF]/30 rounded-lg p-2.5 text-xs text-white focus:border-[#0096FF] focus:outline-none">
                  <option value="" disabled selected>Select...</option>
                  <option value="website-traffic">Website traffic</option>
                  <option value="lead-generation">Lead generation</option>
                  <option value="online-sales">Online sales</option>
                  <option value="brand-credibility">Brand credibility</option>
                  <option value="google-rankings">Google rankings</option>
                </select>
              </div>

              <div>
                <label class="block text-xs text-zinc-300 font-medium mb-1">What is your goal?</label>
                <select required class="w-full bg-[#16213E] border border-[#0096FF]/30 rounded-lg p-2.5 text-xs text-white focus:border-[#0096FF] focus:outline-none">
                  <option value="" disabled selected>Select...</option>
                  <option value="more-enquiries">More enquiries</option>
                  <option value="conversion-rate">Higher conversion rate</option>
                  <option value="faster-website">Faster website</option>
                  <option value="seo-visibility">Better SEO visibility</option>
                  <option value="full-redesign">Full redesign</option>
                </select>
              </div>

              <div>
                <label class="block text-xs text-zinc-300 font-medium mb-1">What is your timeline?</label>
                <select required class="w-full bg-[#16213E] border border-[#0096FF]/30 rounded-lg p-2.5 text-xs text-white focus:border-[#0096FF] focus:outline-none">
                  <option value="" disabled selected>Select...</option>
                  <option value="asap">ASAP (2–4 weeks)</option>
                  <option value="1-2-months">1–2 months</option>
                  <option value="3-plus-months">3+ months</option>
                  <option value="exploring">Just exploring</option>
                </select>
              </div>

              <div>
                <label class="block text-xs text-zinc-300 font-medium mb-1">What is your budget?</label>
                <select required class="w-full bg-[#16213E] border border-[#0096FF]/30 rounded-lg p-2.5 text-xs text-white focus:border-[#0096FF] focus:outline-none">
                  <option value="" disabled selected>Select...</option>
                  <option value="under-10k">Under R10,000</option>
                  <option value="10k-25k">R10,000 – R25,000</option>
                  <option value="25k-60k">R25,000 – R60,000</option>
                  <option value="60k-plus">R60,000+</option>
                </select>
              </div>
            </div>

            <button 
              type="button" 
              id="goto-step-2" 
              class="w-full bg-[#0096FF] hover:bg-[#89CFF0] text-white hover:text-[#16213E] font-bold py-3 rounded-lg text-sm transition mt-4 flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Continue</span>
              <span>→</span>
            </button>
          </div>

          <!-- STEP 2: CONTACT DETAILS -->
          <div id="modal-step-2" class="space-y-4 hidden">
            <h3 class="text-lg font-bold text-white mb-2">Where should we send your plan?</h3>

            <div>
              <label class="block text-xs text-zinc-300 font-medium mb-1">Your name</label>
              <input 
                type="text" 
                placeholder="Full name" 
                required 
                class="w-full bg-[#16213E] border border-[#0096FF]/30 rounded-lg p-2.5 text-xs text-white placeholder-zinc-500 focus:border-[#0096FF] focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs text-zinc-300 font-medium mb-1">Email address*</label>
              <input 
                type="email" 
                placeholder="you@company.co.za" 
                required 
                class="w-full bg-[#16213E] border border-[#0096FF]/30 rounded-lg p-2.5 text-xs text-white placeholder-zinc-500 focus:border-[#0096FF] focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs text-zinc-300 font-medium mb-1">Phone number*</label>
              <input 
                type="tel" 
                placeholder="+27 82 000 0000" 
                required 
                class="w-full bg-[#16213E] border border-[#0096FF]/30 rounded-lg p-2.5 text-xs text-white placeholder-zinc-500 focus:border-[#0096FF] focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs text-zinc-300 font-medium mb-1">Business name</label>
              <input 
                type="text" 
                placeholder="Company or brand" 
                class="w-full bg-[#16213E] border border-[#0096FF]/30 rounded-lg p-2.5 text-xs text-white placeholder-zinc-500 focus:border-[#0096FF] focus:outline-none"
              />
            </div>

            <div class="flex gap-2 pt-2">
              <button 
                type="button" 
                id="back-to-step-1" 
                class="w-1/3 bg-[#16213E] border border-[#0096FF]/30 text-[#89CFF0] font-semibold py-3 rounded-lg text-sm transition hover:bg-[#0096FF]/10 cursor-pointer"
              >
                ← Back
              </button>

              <button 
                type="submit" 
                class="w-2/3 bg-[#0096FF] hover:bg-[#89CFF0] text-white hover:text-[#16213E] font-bold py-3 rounded-lg text-sm transition flex items-center justify-center gap-2 cursor-pointer shadow-lg"
              >
                <span>Get my growth plan</span>
              </button>
            </div>
          </div>

        </form>

        <p class="text-[10px] text-zinc-400 text-center mt-3">
          ✨ Better details help us recommend the right growth system.
        </p>
      </div>

    </div>
  </div>
</div>

<script is:inline>
  const openBtn = document.getElementById('open-growth-modal');
  const closeBtn = document.getElementById('close-growth-modal');
  const modal = document.getElementById('growth-modal');
  
  const step1 = document.getElementById('modal-step-1');
  const step2 = document.getElementById('modal-step-2');
  const nextBtn = document.getElementById('goto-step-2');
  const backBtn = document.getElementById('back-to-step-1');
  
  const progressBar = document.getElementById('progress-bar');
  const stepIndicator = document.getElementById('step-indicator');

  openBtn?.addEventListener('click', () => modal?.classList.remove('hidden'));
  closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));

  // Step 1 -> Step 2
  nextBtn?.addEventListener('click', () => {
    step1?.classList.add('hidden');
    step2?.classList.remove('hidden');
    progressBar?.classList.replace('w-1/2', 'w-full');
    if (stepIndicator) stepIndicator.textContent = 'STEP 2 OF 2';
  });

  // Step 2 -> Step 1
  backBtn?.addEventListener('click', () => {
    step2?.classList.add('hidden');
    step1?.classList.remove('hidden');
    progressBar?.classList.replace('w-full', 'w-1/2');
    if (stepIndicator) stepIndicator.textContent = 'STEP 1 OF 2';
  });

  // Close on outer backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.add('hidden');
  });
</script>