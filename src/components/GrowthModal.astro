  .growth-success-icon svg { width: 40px; height: 40px; }
  .growth-success h3 { margin: 0; font-size: clamp(24px, 2vw, 34px); line-height: 1.2; }
  .growth-success-badge { color: var(--growth-light-blue); font-size: 12px;
    font-weight: 700; letter-spacing: .08em; border: 1px solid rgba(0,150,255,.4);
    border-radius: 999px; padding: 8px 14px; }
  .growth-success p { margin: 0; max-width: 440px; color: var(--growth-muted);
    font-size: 17px; line-height: 1.7; }
  #growth-success-close { border: 0; border-radius: 10px; padding: 14px 24px;
    background: var(--growth-blue); color: white; font: inherit; cursor: pointer; }
  @media (min-width: 1201px) {
    .growth-panel { min-height: 650px; padding: 24px 30px; }
    .growth-logo { margin-bottom: 24px; }
