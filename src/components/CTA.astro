---
/* CTA.astro - Hybrid Interactive Contact Form */
---

<section class="cta-section" id="contact">
  <div class="container">
    <div class="section-header">
      <span class="sub-heading">START YOUR PROJECT</span>
      <h2 class="section-title">Let’s Engineer Something High-Impact</h2>
      <p class="section-intro">
        Select your project scope below to unlock a tailored roadmap and quote.
      </p>
    </div>

    <form class="interactive-form" id="hybridForm" onsubmit="event.preventDefault();">
      
      <div class="form-phase phase-1">
        <label class="phase-label">1. Tell us what you need engineered 🌐</label>
        <div class="option-grid">
          <button type="button" class="option-btn" data-type="service" data-value="Full Custom Website">
            <span class="btn-icon">🌐</span>
            <span class="btn-title">Full Custom Website</span>
            <span class="btn-desc">High-speed, SEO-focused site</span>
          </button>
          <button type="button" class="option-btn" data-type="service" data-value="Speed Optimization">
            <span class="btn-icon">⚡</span>
            <span class="btn-title">Speed Optimization</span>
            <span class="btn-desc">Rebuild bloated WP to custom code</span>
          </button>
          <button type="button" class="option-btn" data-type="service" data-value="E-Commerce Store">
            <span class="btn-icon">🛒</span>
            <span class="btn-title">E-Commerce Store</span>
            <span class="btn-desc">Fast checkout & payment setup</span>
          </button>
        </div>
      </div>

      <div class="form-phase phase-2 hidden" id="phase2">
        <label class="phase-label">2. Select your budget & timeline 📊</label>
        
        <div class="selection-group">
          <p class="group-title">Estimated Budget (ZAR):</p>
          <div class="pill-group">
            <button type="button" class="pill-btn" data-type="budget" data-value="R9,500 - R15,000">R9.5k – R15k</button>
            <button type="button" class="pill-btn" data-type="budget" data-value="R15,000 - R30,000">R15k – R30k</button>
            <button type="button" class="pill-btn" data-type="budget" data-value="R30,000 - R60,000">R30k – R60k</button>
            <button type="button" class="pill-btn" data-type="budget" data-value="R60,000+">R60k+</button>
          </div>
        </div>

        <div class="selection-group">
          <p class="group-title">Target Launch Timeline:</p>
          <div class="pill-group">
            <button type="button" class="pill-btn" data-type="timeline" data-value="Under 1 month">Under 1 month ⚡</button>
            <button type="button" class="pill-btn" data-type="timeline" data-value="1 - 3 months">1 – 3 months 📅</button>
            <button type="button" class="pill-btn" data-type="timeline" data-value="No immediate rush">No immediate rush ☕</button>
          </div>
        </div>
      </div>

      <div class="form-phase phase-3 hidden" id="phase3">
        <label class="phase-label">3. Final details ✍️</label>
        
        <div class="mad-libs-container">
          <p class="group-title">
            Hi, my name is 
            <input type="text" id="name" placeholder="First Name" required class="inline-input" /> 
            and I run a business in 
            <input type="text" id="industry" placeholder="Industry/Niche" required class="inline-input" />. 
            You can reach me at 
            <input type="email" id="email" placeholder="Email Address" required class="inline-input" /> 
            or 
            <input type="tel" id="phone" placeholder="Phone Number" class="inline-input" />.
          </p>
        </div>

        <div class="submit-wrapper">
          <button type="submit" class="submit-btn">Let’s Talk Architecture 🚀</button>
        </div>
      </div>

    </form>
  </div>
</section>

<script>
  // Dynamic single-page reveal interactions
  const serviceBtns = document.querySelectorAll('[data-type="service"]');
  const budgetBtns = document.querySelectorAll('[data-type="budget"]');
  const timelineBtns = document.querySelectorAll('[data-type="timeline"]');

  const phase2 = document.getElementById('phase2');
  const phase3 = document.getElementById('phase3');

  let selectedService = '';
  let selectedBudget = '';
  let selectedTimeline = '';

  function checkPhase3Reveal() {
    if (selectedBudget && selectedTimeline) {
      phase3?.classList.remove('hidden');
    }
  }

  // Step 1 Selection
  serviceBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      serviceBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedService = btn.getAttribute('data-value') || '';
      
      // Reveal Phase 2
      phase2?.classList.remove('hidden');
    });
  });

  // Step 2 Budget Selection
  budgetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      budgetBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedBudget = btn.getAttribute('data-value') || '';
      checkPhase3Reveal();
    });
  });

  // Step 2 Timeline Selection
  timelineBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      timelineBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedTimeline = btn.getAttribute('data-value') || '';
      checkPhase3Reveal();
    });
  });
</script>

<style>
  .cta-section {
    background-color: #000000;
    color: #ffffff;
    padding: 5rem 1.5rem;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .sub-heading {
    color: #0096FF;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0.5rem 0 1rem;
  }

  .section-intro {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
  }

  .form-phase {
    margin-bottom: 2.5rem;
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .form-phase.hidden {
    display: none;
  }

  /* Phase Label (Styled to H3 scale with Cabinet Grotesk) */
  .phase-label {
    display: block;
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #89CFF0;
  }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .option-btn {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 1.25rem;
    color: #ffffff;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .option-btn:hover, .option-btn.active {
    border-color: #0096FF;
    background: rgba(0, 150, 255, 0.1);
  }

  .btn-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  /* Button Title (Styled to H4 scale with Cabinet Grotesk) */
  .btn-title {
    display: block;
    font-family: 'Cabinet Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .btn-desc {
    display: block;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .selection-group {
    margin-bottom: 1.5rem;
  }

  .group-title {
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pill-btn {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
    padding: 0.6rem 1.25rem;
    color: #ffffff;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pill-btn:hover, .pill-btn.active {
    border-color: #0096FF;
    background: #0096FF;
  }

  .inline-input {
    background: transparent;
    border: none;
    border-bottom: 2px solid #0096FF;
    color: #ffffff;
    padding: 0.25rem 0.5rem;
    font-size: 1.1rem;
    outline: none;
    width: auto;
    min-width: 150px;
  }

  .inline-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .submit-wrapper {
    margin-top: 2rem;
    text-align: center;
  }

  .submit-btn {
    background: #0096FF;
    color: #ffffff;
    font-weight: 700;
    border: none;
    border-radius: 6px;
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .submit-btn:hover {
    background: #0077cc;
  }
</style>