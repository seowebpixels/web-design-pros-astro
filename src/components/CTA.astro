---
/* CTA.astro - Hybrid Interactive Contact Form */
---

<section class="cta-section" id="contact">
  <div class="container">
    <div class="section-header">
      <span class="sub-heading">START YOUR PROJECT</span>
      <h2 class="section-title">Tell Us What You're Planning</h2>
      <p class="section-intro">
        Share a few details below and we'll come back to you with a practical recommendation for your website.
      </p>
    </div>

    <form class="interactive-form" id="hybridForm">
      <input
        type="text"
        id="cta-company-site"
        name="website"
        class="form-honeypot"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      
      <div class="form-phase phase-1">
        <label class="phase-label">1. Tell us what you need 🌐</label>
        <div class="option-grid">
          <button type="button" class="option-btn" data-type="service" data-value="Full Custom Website">
            <span class="btn-icon">🌐</span>
            <span class="btn-title">Full Custom Website</span>
            <span class="btn-desc">High-speed, SEO-focused site</span>
          </button>
          <button type="button" class="option-btn" data-type="service" data-value="Speed Optimization">
            <span class="btn-icon">⚡</span>
            <span class="btn-title">Speed Optimization</span>
            <span class="btn-desc">Rebuild bloated WP to custom code</span>
          </button>
          <button type="button" class="option-btn" data-type="service" data-value="E-Commerce Store">
            <span class="btn-icon">🛒</span>
            <span class="btn-title">E-Commerce Store</span>
            <span class="btn-desc">Fast checkout & payment setup</span>
          </button>
        </div>
      </div>

      <div class="form-phase phase-2 hidden" id="phase2">
        <label class="phase-label">2. Select your budget & timeline 📊</label>
        
        <div class="selection-group">
          <p class="group-title">Estimated Budget (ZAR):</p>
          <div class="pill-group">
            <button type="button" class="pill-btn" data-type="budget" data-value="R9,500 - R15,000">R9.5k – R15k</button>
            <button type="button" class="pill-btn" data-type="budget" data-value="R15,000 - R30,000">R15k – R30k</button>
            <button type="button" class="pill-btn" data-type="budget" data-value="R30,000 - R60,000">R30k – R60k</button>
            <button type="button" class="pill-btn" data-type="budget" data-value="R60,000+">R60k+</button>
          </div>
        </div>

        <div class="selection-group">
          <p class="group-title">Target Launch Timeline:</p>
          <div class="pill-group">
            <button type="button" class="pill-btn" data-type="timeline" data-value="Under 1 month">Under 1 month ⚡</button>
            <button type="button" class="pill-btn" data-type="timeline" data-value="1 - 3 months">1 – 3 months 📅</button>
            <button type="button" class="pill-btn" data-type="timeline" data-value="No immediate rush">No immediate rush ☕</button>
          </div>
        </div>
      </div>

      <div class="form-phase phase-3 hidden" id="phase3">
        <label class="phase-label">3. Final details ✍️</label>
        
        <div class="mad-libs-container">
          <p class="group-title">
            Hi, my name is 
            <input type="text" id="name" name="name" autocomplete="name" placeholder="First Name" required class="inline-input" /> 
            and I run a business in 
            <input type="text" id="industry" name="industry" autocomplete="organization-title" placeholder="Industry/Niche" required class="inline-input" />. 
            You can reach me at 
            <input type="email" id="email" name="email" autocomplete="email" placeholder="Email Address" required class="inline-input" /> 
            or 
            <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="Phone Number" class="inline-input" />.
          </p>
        </div>

        <div class="submit-wrapper">
          <button type="submit" class="submit-btn" id="cta-submit-btn">Send My Project Enquiry 🚀</button>
        </div>
      </div>

      <p
        id="cta-form-status"
        class="form-status"
        role="status"
        aria-live="polite"
        tabindex="-1"
      ></p>

    </form>
  </div>
</section>

<script>
  // Dynamic single-page reveal interactions
  const hybridForm = document.getElementById('hybridForm');
  const serviceBtns = document.querySelectorAll<HTMLButtonElement>('[data-type="service"]');
  const budgetBtns = document.querySelectorAll<HTMLButtonElement>('[data-type="budget"]');
  const timelineBtns = document.querySelectorAll<HTMLButtonElement>('[data-type="timeline"]');

  const phase2 = document.getElementById('phase2');
  const phase3 = document.getElementById('phase3');
  const submitBtn = document.getElementById('cta-submit-btn');
  const formStatus = document.getElementById('cta-form-status');

  let selectedService = '';
  let selectedBudget = '';
  let selectedTimeline = '';
  let isSubmitting = false;

  function setPressed(
    buttons: NodeListOf<HTMLButtonElement>,
    activeButton: HTMLButtonElement | null
  ) {
    buttons.forEach(button => {
      const isActive = button === activeButton;
      button.classList.toggle('active', isActive);
      button.setAttribute('aria-pressed', String(isActive));
    });
  }

  function setFormStatus(message: string, kind: 'error' | 'success') {
    if (!formStatus) return;
    formStatus.textContent = message;
    formStatus.classList.remove('status-error', 'status-success');
    formStatus.classList.add(kind === 'error' ? 'status-error' : 'status-success');
    formStatus.setAttribute('role', kind === 'error' ? 'alert' : 'status');
    formStatus.focus();
  }

  function inputValue(id: string) {
    const input = document.getElementById(id);
    return input instanceof HTMLInputElement ? input.value.trim() : '';
  }

  function checkPhase3Reveal() {
    if (selectedBudget && selectedTimeline) {
      phase3?.classList.remove('hidden');
    }
  }

  // Step 1 Selection
  serviceBtns.forEach(btn => {
    btn.setAttribute('aria-pressed', 'false');
    btn.addEventListener('click', () => {
      setPressed(serviceBtns, btn);
      selectedService = btn.getAttribute('data-value') || '';
      
      // Reveal Phase 2
      phase2?.classList.remove('hidden');
    });
  });

  // Step 2 Budget Selection
  budgetBtns.forEach(btn => {
    btn.setAttribute('aria-pressed', 'false');
    btn.addEventListener('click', () => {
      setPressed(budgetBtns, btn);
      selectedBudget = btn.getAttribute('data-value') || '';
      checkPhase3Reveal();
    });
  });

  // Step 2 Timeline Selection
  timelineBtns.forEach(btn => {
    btn.setAttribute('aria-pressed', 'false');
    btn.addEventListener('click', () => {
      setPressed(timelineBtns, btn);
      selectedTimeline = btn.getAttribute('data-value') || '';
      checkPhase3Reveal();
    });
  });

  hybridForm?.addEventListener('submit', async event => {
    event.preventDefault();
    if (isSubmitting) return;

    const nameInput = document.getElementById('name');
    const industryInput = document.getElementById('industry');
    const emailInput = document.getElementById('email');

    const name = inputValue('name');
    const industry = inputValue('industry');
    const email = inputValue('email');
    const phone = inputValue('phone');
    const website = inputValue('cta-company-site');

    if (!selectedService) {
      setFormStatus('Please select the service you need.', 'error');
      serviceBtns[0]?.focus();
      return;
    }

    if (!selectedBudget || !selectedTimeline) {
      setFormStatus('Please select your budget and target timeline.', 'error');
      (!selectedBudget ? budgetBtns[0] : timelineBtns[0])?.focus();
      return;
    }

    if (!name) {
      setFormStatus('Please enter your name.', 'error');
      nameInput?.focus();
      return;
    }

    if (!industry) {
      setFormStatus('Please enter your industry or niche.', 'error');
      industryInput?.focus();
      return;
    }

    if (!(emailInput instanceof HTMLInputElement) || !emailInput.validity.valid) {
      setFormStatus('Please enter a valid email address.', 'error');
      emailInput?.focus();
      return;
    }

    isSubmitting = true;
    if (submitBtn instanceof HTMLButtonElement) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
    }

    try {
      const response = await fetch('/api/enquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          source: 'contact-form',
          name,
          industry,
          email,
          phone,
          service: selectedService,
          budget: selectedBudget,
          timeline: selectedTimeline,
          website,
        }),
      });

      let result: { ok?: boolean; error?: string } = {};
      try {
        result = await response.json();
      } catch {
        // A non-JSON response is handled as a failed submission below.
      }

      if (response.ok && result && result.ok) {
        hybridForm instanceof HTMLFormElement && hybridForm.reset();
        selectedService = '';
        selectedBudget = '';
        selectedTimeline = '';
        setPressed(serviceBtns, null);
        setPressed(budgetBtns, null);
        setPressed(timelineBtns, null);
        phase2?.classList.add('hidden');
        phase3?.classList.add('hidden');
        setFormStatus('Thanks — your project enquiry has been sent. We’ll be in touch shortly.', 'success');
      } else {
        setFormStatus(
          (result && result.error) || 'Something went wrong sending your enquiry. Please try again.',
          'error'
        );
      }
    } catch {
      setFormStatus(
        'Something went wrong sending your enquiry. Please check your connection and try again.',
        'error'
      );
    } finally {
      isSubmitting = false;
      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send My Project Enquiry 🚀';
      }
    }
  });
</script>

<style>
  .cta-section {
    background-color: #000000;
    color: #ffffff;
    padding: 5rem 1.5rem;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .sub-heading {
    color: #0096FF;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0.5rem 0 1rem;
  }

  .section-intro {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
  }

  .form-phase {
    margin-bottom: 2.5rem;
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .form-phase.hidden {
    display: none;
  }

  /* Phase Label (Styled to H3 scale with Cabinet Grotesk) */
  .phase-label {
    display: block;
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #89CFF0;
  }

  .option-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .option-btn {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 1.25rem;
    color: #ffffff;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .option-btn:hover, .option-btn.active {
    border-color: #0096FF;
    background: rgba(0, 150, 255, 0.1);
  }

  .btn-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  /* Button Title (Styled to H4 scale with Cabinet Grotesk) */
  .btn-title {
    display: block;
    font-family: 'Cabinet Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .btn-desc {
    display: block;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .selection-group {
    margin-bottom: 1.5rem;
  }

  .group-title {
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 2;
  }

  .pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pill-btn {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
    padding: 0.6rem 1.25rem;
    color: #ffffff;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pill-btn:hover, .pill-btn.active {
    border-color: #0096FF;
    background: #0096FF;
  }

  .inline-input {
    background: transparent;
    border: none;
    border-bottom: 2px solid #0096FF;
    color: inherit;
    font: inherit;
    text-align: center;
    padding: 0.1rem 0.4rem;
    outline: none;
    width: auto;
    min-width: 150px;
  }

  .inline-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
    text-align: center;
  }

  .submit-wrapper {
    margin-top: 2rem;
    text-align: center;
  }

  .submit-btn {
    background: #0096FF;
    color: #ffffff;
    font-weight: 700;
    border: none;
    border-radius: 6px;
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .submit-btn:hover {
    background: #0077cc;
  }

  .submit-btn:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .form-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-status {
    min-height: 1.5rem;
    margin: 1rem 0 0;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.5;
    outline: none;
  }

  .form-status:empty {
    min-height: 0;
    margin: 0;
  }

  .form-status.status-error {
    color: #ff8b8b;
  }

  .form-status.status-success {
    color: #7ee2b8;
  }
</style>
