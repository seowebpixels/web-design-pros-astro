---
import {services as catalogue} from '../data/services';
const services=catalogue.map(service=>({...service,description:service.summary,link:`/services/${service.slug}/`}));
---

<section class="services-section" id="services">
  <div class="container">
    <h2 class="section-title">Our Services</h2>
    <div class="services-grid">
      {services.map((service) => (
        <a href={service.link} class="service-card">
          <div class="icon">{service.icon}</div>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          
          <ul class="feature-list">
            {service.features.map((feature) => (
              <li>
                <span class="bullet-check">✓</span> {feature}
              </li>
            ))}
          </ul>

          <span class="card-link">Learn More &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: #ffffff;
    text-align: center;
  }

  /* 3x3 Grid Layout for Desktop */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* Responsive Adjustments */
  @media (max-width: 992px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr); /* 2 columns on tablets */
    }
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr; /* Single column on mobile */
    }
  }

  .service-card {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 2rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: #9EEAFC;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .service-card h3 {
    font-size: 1.5rem;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .service-card p {
    font-size: 0.95rem;
    opacity: 0.85;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  /* Bullet List Styling */
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1; /* Pushes the Learn More link to the bottom evenly */
  }

  .feature-list li {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bullet-check {
    color: #9EEAFC;
    font-weight: bold;
    font-size: 0.9rem;
  }

  .card-link {
    color: #9EEAFC;
    font-weight: 600;
    font-size: 0.95rem;
    margin-top: auto;
  }
</style>