<section class="py-16 bg-slate-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-4">
        Areas We Serve Across Gauteng
      </h2>
      <p class="text-slate-400 text-lg">
        We build ultra fast, high-converting custom coded websites tailored specifically for growing businesses across major Gauteng hubs. No slow WordPress templates or heavy plugin bloated websites. 
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {locations.map((loc) => (
        <div class="bg-slate-800/80 border border-slate-700/60 rounded-xl p-6 flex flex-col justify-between hover:border-sky-500/50 transition-all duration-300 hover:-translate-y-1">
          <div>
            <h3 class="text-xl font-semibold text-white mb-3">{loc.name}</h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-6">
              {loc.description}
            </p>
          </div>
          <div>
            <a 
              href={`/${loc.slug}`} 
              class="inline-flex items-center text-xs font-medium text-sky-400 hover:text-sky-300 uppercase tracking-wider transition-colors"
            >
              Learn More
              <svg class="w-3.5 h-3.5 ml-1 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>