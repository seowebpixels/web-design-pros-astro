---
// src/components/DomainSection.astro

// Featured Domain Packages (Top row: Big Cards, Bottom row: Small Cards)
const mainDomains = [
  {
    tld: '.co.za',
    badge: 'SOUTH AFRICAN ENTITY',
    badgeColor: 'bg-gray-200/20 text-gray-200 border-gray-400/30',
    oldPrice: 'R95',
    price: 'R75',
    dealBadge: 'GREAT DEAL',
  },
  {
    tld: '.com',
    badge: 'GLOBAL CHOICE',
    badgeColor: 'bg-gray-200/20 text-gray-200 border-gray-400/30',
    oldPrice: 'R280',
    price: 'R200',
    dealBadge: 'GREAT DEAL',
  }
];

const subDomains = [
  { tld: '.org.za', subtitle: 'SOUTH AFRICAN ORGANISATIONS', price: 'R95' },
  { tld: '.org', subtitle: 'ORGANISATIONS', price: 'R200' },
  { tld: '.net', subtitle: 'ORGANISATIONS', price: 'R200' },
  { tld: '.shop', subtitle: 'ONLINE SHOPS', price: 'R250' },
  { tld: '.online', subtitle: 'DIGITAL BRANDS', price: 'R100' },
  { tld: '.site', subtitle: 'DIGITAL BRANDS', price: 'R105' }
];
---

<section class="w-full py-16 md:py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto font-jakarta">
  
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
    <div class="space-y-2">
      <span class="text-xs md:text-sm font-bold tracking-widest text-[#0096FF] uppercase">
        SOUTH AFRICAN DOMAIN NAMES 🇿🇦
      </span>
      <h2 class="text-2xl md:text-3xl font-extrabold text-white">
        Register a .CO.ZA Domain
      </h2>
      <p class="text-gray-300 text-sm md:text-base max-w-xl">
        Use .co.za to show your South African connection, or compare popular global extensions.
      </p>
    </div>

    <a 
      href="/domains" 
      class="inline-flex items-center justify-center bg-[#0096FF] hover:bg-[#89CFF0] hover:text-[#16213E] text-white font-bold text-base md:text-lg py-3.5 px-8 rounded-2xl shadow-lg transition-all duration-200 active:scale-95"
    >
      Search domains
    </a>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 text-sm text-gray-300">
    <div class="flex items-center gap-2 flex-wrap">
      <span>CO.ZA domains start from</span>
      <span class="line-through text-gray-400">R95</span>
      <span class="text-white font-bold text-base">R 75.00</span>
      <span class="bg-[#0096FF] text-white text-xs font-bold px-2.5 py-1 rounded-full uppercase">
        GREAT DEAL
      </span>
      <span>/ first year</span>
    </div>

    <div class="flex items-center gap-2 text-xs md:text-sm text-gray-300 self-end sm:self-auto">
      <span>Sort by: <strong>Alphabetical / Cheapest first</strong></span>
      <div class="w-7 h-7 rounded-full bg-[#0096FF] text-white flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </div>
  </div>

  <div class="space-y-6">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {mainDomains.map((domain) => (
        <a 
          href={`/domains?tld=${domain.tld}`} 
          class="group relative block bg-[#16213E]/60 backdrop-blur-md border border-[#0096FF]/30 hover:border-[#0096FF] rounded-3xl p-6 md:p-8 transition-all duration-300 hover:shadow-2xl hover:shadow-[#0096FF]/20 hover:-translate-y-1"
        >
          <div class="flex flex-col space-y-4">
            <span class={`self-start text-xs font-semibold px-3 py-1 rounded-full border ${domain.badgeColor}`}>
              {domain.badge}
            </span>
            <h3 class="text-4xl md:text-5xl font-black text-white group-hover:text-[#0096FF] transition-colors">
              {domain.tld}
            </h3>
            <div class="flex items-center gap-2 text-gray-300 pt-2">
              <span>From</span>
              <span class="line-through text-gray-400">{domain.oldPrice}</span>
              <span class="text-white font-bold text-xl">{domain.price}</span>
              <span class="bg-[#0096FF] text-white text-xs font-bold px-2.5 py-0.5 rounded-full">
                {domain.dealBadge}
              </span>
              <span class="text-xs text-gray-400">/year</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
      {subDomains.map((domain) => (
        <a 
          href={`/domains?tld=${domain.tld}`} 
          class="group block bg-[#16213E]/50 backdrop-blur-md border border-[#0096FF]/20 hover:border-[#0096FF] rounded-2xl p-4 text-center transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
        >
          <h4 class="text-2xl font-bold text-white group-hover:text-[#0096FF] transition-colors">
            {domain.tld}
          </h4>
          <span class="text-[10px] text-gray-400 font-semibold block mt-1 tracking-wider uppercase min-h-[28px]">
            {domain.subtitle}
          </span>
          <span class="text-base font-bold text-white block mt-2">
            {domain.price} <span class="text-xs font-normal text-gray-400">/yr</span>
          </span>
        </a>
      ))}
    </div>

  </div>

  <div class="mt-10 space-y-4">
    <a 
      href="/domains" 
      class="block w-full sm:w-auto text-center bg-[#0096FF] hover:bg-[#89CFF0] hover:text-[#16213E] text-white font-bold text-base md:text-lg py-4 px-8 rounded-2xl shadow-md transition-all duration-200"
    >
      Check a domain
    </a>

    <button 
      type="button" 
      id="show-more-domains-btn" 
      class="w-full bg-[#0096FF] hover:bg-[#89CFF0] hover:text-[#16213E] text-white font-bold text-base md:text-lg py-4 px-8 rounded-2xl shadow-md transition-all duration-200 cursor-pointer text-center"
    >
      Show more
    </button>
  </div>

</section>