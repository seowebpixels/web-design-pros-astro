---
/* 1. Primary Featured Domains (Top Row) */
const primaryDomains = [
  {
    tld: '.co.za',
    category: 'SOUTH AFRICAN ENTITY',
    oldPrice: 'R95',
    price: 'R75',
    period: '/year',
    badge: 'GREAT DEAL'
  },
  {
    tld: '.com',
    category: 'GLOBAL CHOICE',
    oldPrice: 'R280',
    price: 'R200',
    period: '/year',
    badge: 'GREAT DEAL'
  }
];

/* 2. Secondary Domains (Bottom Row) */
const secondaryDomains = [
  { tld: '.org.za', category: 'SOUTH AFRICAN ORGANISATIONS', price: 'R95/yr' },
  { tld: '.org', category: 'ORGANISATIONS', price: 'R200/yr' },
  { tld: '.net', category: 'ORGANISATIONS', price: 'R200/yr' },
  { tld: '.shop', category: 'ONLINE SHOPS', price: 'R250/yr' },
  { tld: '.online', category: 'DIGITAL BRANDS', price: 'R100/yr' },
  { tld: '.site', category: 'DIGITAL BRANDS', price: 'R105/yr' }
];
---

<section class="domain-section">
  <div class="container">
    
    <!-- Header Block -->
    <div class="domain-header">
      <div class="header-text">
        <span class="sub-heading">SOUTH AFRICAN DOMAIN NAMES</span>
        <h2 class="section-title">Register a .CO.ZA Domain</h2>
        <p class="description">Use .co.za to show your South African connection, or compare popular global extensions.</p>
      </div>
      <a href="/domains" class="btn-primary">Search domains</a>
    </div>

    <!-- Sub-header Deal Bar -->
    <div class="deal-bar">
      <div class="deal-info">
        <span>CO.ZA domains start from</span>
        <span class="old-price">R95</span>
        <span class="highlight-price">R 75.00</span>
        <span class="deal-badge">GREAT DEAL</span>
        <span class="period">/ first year</span>
      </div>
      <div class="sort-info">
        <span>Sort by: <strong>Alphabetical / Cheapest first</strong></span>
        <span class="sort-icon">▼</span>
      </div>
    </div>

    <!-- Top Grid: 2 Large Cards -->
    <div class="primary-grid">
      {primaryDomains.map((item) => (
        <a href={`/domains?tld=${item.tld}`} class="glass-card primary-card">
          <span class="category-tag">{item.category}</span>
          <h3 class="tld-title">{item.tld}</h3>
          <div class="pricing-row">
            <span class="label">From</span>
            <span class="old-price">{item.oldPrice}</span>
            <span class="price">{item.price}</span>
            <span class="deal-badge">{item.badge}</span>
            <span class="period">{item.period}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Grid: 6 Smaller Cards -->
    <div class="secondary-grid">
      {secondaryDomains.map((item) => (
        <a href={`/domains?tld=${item.tld}`} class="glass-card secondary-card">
          <h4 class="tld-title-sm">{item.tld}</h4>
          <span class="sub-category">{item.category}</span>
          <div class="price-sm">{item.price}</div>
        </a>
      ))}
    </div>

    <!-- Bottom Action Area -->
    <div class="actions-wrapper">
      <a href="/domains" class="btn-action">Check a domain</a>
      <button type="button" id="show-more-btn" class="btn-action">Show more</button>
    </div>

  </div>
</section>

<style>
  /* Base Container Layout */
  .domain-section {
    padding: 5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    font-family: inherit;
  }

  .container {
    width: 100%;
  }

  /* Header Section */
  .domain-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .domain-header {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .sub-heading {
    color: #89CFF0;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    display: block;
    margin-bottom: 0.25rem;
  }

  .section-title {
    font-size: 2.25rem;
    color: #ffffff;
    margin: 0 0 0.5rem 0;
    font-weight: 800;
  }

  .description {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  /* Sub-header Deal Bar */
  .deal-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .deal-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .old-price {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .highlight-price {
    color: #ffffff;
    font-weight: 700;
  }

  .deal-badge {
    background: #0096FF;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .sort-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .sort-icon {
    width: 24px;
    height: 24px;
    background: #0096FF;
    color: #ffffff;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
  }

  /* Glassmorphic Cards (Exact styles from Pricing.astro) */
  .glass-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 7px !important; /* Strict 7px radius */
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .glass-card:hover {
    border-color: #0096FF;
    box-shadow: 0 0 15px rgba(0, 150, 255, 0.3);
    transform: translateY(-2px);
  }

  /* Primary Grid (Top 2 Cards) */
  .primary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .primary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .primary-card {
    padding: 2rem;
  }

  .category-tag {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: 7px;
    align-self: flex-start;
    margin-bottom: 1rem;
    letter-spacing: 0.5px;
  }

  .tld-title {
    font-size: 2.75rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 1rem 0;
  }

  .pricing-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    flex-wrap: wrap;
  }

  .pricing-row .price {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
  }

  /* Secondary Grid (Bottom 6 Cards) */
  .secondary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 1024px) {
    .secondary-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .secondary-card {
    padding: 1.25rem 0.85rem;
    text-align: center;
    align-items: center;
    justify-content: space-between;
  }

  .tld-title-sm {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.25rem 0;
  }

  .sub-category {
    font-size: 0.65rem;
    color: #89CFF0;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 0.75rem;
    min-height: 24px;
    display: flex;
    align-items: center;
  }

  .price-sm {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0096FF;
  }

  /* Buttons & Action Styling */
  .btn-primary {
    background: #0096FF;
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: 7px !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition: background 0.2s ease;
    white-space: nowrap;
  }

  .btn-primary:hover {
    background: #89CFF0;
    color: #16213E;
  }

  .actions-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .btn-action {
    display: block;
    width: 100%;
    text-align: center;
    background: #0096FF;
    color: #ffffff;
    padding: 1rem;
    border-radius: 7px !important;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .btn-action:hover {
    background: #89CFF0;
    color: #16213E;
  }
</style>