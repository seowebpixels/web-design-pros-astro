---
import {Image} from 'astro:assets';
import facet from '../assets/facet.avif';
import star from '../assets/star.avif';
import uncut from '../assets/uncut.avif';
interface Props {showWork?:boolean}
const {showWork=false}=Astro.props;
const projects=[{name:'Facet Architecture',category:'Architecture & design',image:facet,url:'https://facetarchitecture.co.za/'},{name:'Star Recruitment',category:'Recruitment',image:star,url:'https://starrecruitmentagents.co.za/'},{name:'Uncut Electro-Mechanical',category:'Industrial services',image:uncut,url:'https://uncutelecmech.co.za/'}];
---
<section class="service-trust" id="local" aria-labelledby="service-trust-heading">
 <div class="trust-company"><p class="trust-eyebrow">Who you’ll work with</p><h2 id="service-trust-heading">Web Design Pros (Pty) Ltd</h2><p>Based in Northcliff, Johannesburg, WDP brings website design, development and digital services together for South African businesses. Your point of contact is Marlan Pather. We explain the decisions behind the work, keep the project focused on your goals and give you a clear view of what comes next.</p><div class="trust-links"><a href="/about/">Meet the business →</a><a href="/docs/cipc-registration-certificate.pdf">Company registration</a><a href="/contact/">Speak to Marlan →</a></div></div>
 <div class="trust-delivery"><h3>Know what you’re agreeing to.</h3><p>Your proposal sets out the deliverables, responsibilities, review stages and costs. Account access, ownership, third-party charges and ongoing support are clarified for your project.</p><a href="/terms/">Read our terms of service →</a></div>
 {showWork&&<div class="trust-work" id="concepts"><p class="trust-eyebrow">Examples from our portfolio</p><h2>See the work for yourself.</h2><div class="trust-projects">{projects.map(project=><a href={project.url} target="_blank" rel="noopener noreferrer"><Image src={project.image} width={480} alt={`${project.name} website preview from the Web Design Pros portfolio`} loading="lazy"/><div><h3>{project.name}</h3><p>{project.category}</p><span>Visit website ↗</span></div></a>)}</div></div>}
</section>
<style>
 .service-trust{max-width:1200px;width:calc(100% - 48px);margin:0 auto;padding-block:65px;display:grid;grid-template-columns:1.4fr 1fr;gap:35px;border-top:1px solid #344660;color:#f1f5ff}.trust-eyebrow{font-size:.75rem;text-transform:uppercase;letter-spacing:.12em;color:#89cff0;margin-bottom:14px}.service-trust h2{font-size:clamp(1.6rem,3vw,2.3rem);line-height:1.2;margin-bottom:18px}.service-trust p:not(.trust-eyebrow){font-size:.9rem;line-height:1.85;color:#bbcbe0}.service-trust a{color:#89cff0;font-size:.85rem;text-underline-offset:4px}.service-trust a:focus-visible{outline:2px solid #89cff0;outline-offset:5px}.trust-links{display:flex;flex-wrap:wrap;gap:15px;margin-top:22px}.trust-delivery{border-left:3px solid #0096ff;background:#1c2b47;padding:25px}.trust-delivery h3{font-size:1.2rem;font-weight:700;margin-bottom:14px}.trust-delivery a{display:inline-block;margin-top:15px}.trust-work{grid-column:1/-1;margin-top:20px}.trust-projects{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.trust-projects>a{text-decoration:none;border:1px solid #3a4d68;border-radius:9px;overflow:hidden;background:#19283f}.trust-projects img{width:100%;height:170px;object-fit:cover;object-position:top}.trust-projects a>div{padding:22px}.trust-projects h3{color:#fff;font-weight:700;font-size:1.1rem;margin-bottom:7px}.trust-projects span{display:inline-block;margin-top:15px}@media(max-width:700px){.service-trust{width:calc(100% - 36px);grid-template-columns:1fr;padding-block:45px;gap:25px}.trust-projects{grid-template-columns:1fr}.trust-projects img{height:210px}}
</style>
