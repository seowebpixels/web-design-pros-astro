---
// src/pages/domains.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Domain Registration & Pricing | WebDesignPros">
  <main class="min-h-screen bg-slate-950 text-white py-12 px-4 sm:px-6 lg:px-8 space-y-24">
    
    <!-- 1. HERO SEARCH SECTION -->
    <section class="max-w-4xl mx-auto text-center space-y-6 pt-8">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
        Register Your Domain Name Today
      </h1>
      <p class="text-xl text-cyan-400 font-medium">
        From as low as R75 / year <span class="text-slate-400 font-normal">(Hurry, limited-time offer!)</span>
      </p>

      <form id="domain-search-form" class="mt-8 flex flex-col sm:flex-row gap-3 max-w-2xl mx-auto">
        <input 
          type="text" 
          id="domain-input"
          placeholder="Search for your domain name..." 
          class="flex-1 px-5 py-4 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 glassmorphism"
          required
        />
        <button 
          type="submit" 
          class="px-8 py-4 rounded-xl bg-cyan-600 hover:bg-cyan-500 font-bold text-white transition-all shadow-lg shadow-cyan-900/40"
        >
          Search Domain
        </button>
      </form>
    </section>

    <!-- 2. DYNAMIC SEARCH RESULT DISPLAY (Hidden by default) -->
    <section id="result-container" class="max-w-2xl mx-auto hidden">
      <div class="p-6 rounded-2xl bg-slate-900/90 border border-cyan-500/30 glassmorphism flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-xs uppercase font-bold tracking-wider text-emerald-400 bg-emerald-950/60 px-2.5 py-1 rounded-full border border-emerald-500/30">Available</span>
          <h3 id="result-domain-name" class="text-2xl font-bold mt-2 text-white">example.co.za</h3>
          <p class="text-sm text-slate-400">Renews at R85.00/yr</p>
        </div>
        
        <div class="text-right flex flex-col items-end gap-2 w-full sm:w-auto">
          <div class="text-2xl font-black text-white">R75.00 <span class="text-xs text-slate-400 font-normal">/ 1st Yr</span></div>
          <button id="buy-now-btn" class="w-full sm:w-auto px-6 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 font-semibold text-white transition-all">
            Buy Now &rarr;
          </button>
        </div>
      </div>
    </section>

    <!-- 3. DOMAIN REGISTRATION PRICES SECTION -->
    <section class="max-w-6xl mx-auto space-y-8">
      <div>
        <h2 class="text-3xl font-bold text-white">Domain Registration Prices</h2>
        <p class="text-slate-400 mt-2">
          At Web Design Pros, we provide clear, competitive pricing on popular South African and global domain extensions.
        </p>
      </div>

      <!-- Table Controls & Filters -->
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 glassmorphism space-y-6">
        
        <!-- Category Filter Pills -->
        <div class="flex flex-wrap gap-2">
          <button class="px-4 py-2 rounded-lg bg-cyan-600 text-white font-semibold text-sm">All Domains</button>
          <button class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium text-sm transition-colors">Popular</button>
          <button class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium text-sm transition-colors">New</button>
          <button class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium text-sm transition-colors">Hot</button>
          <button class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium text-sm transition-colors">Sale</button>
        </div>

        <!-- Search Table Input -->
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
          <input 
            type="text" 
            placeholder="Search domain extensions..." 
            class="w-full sm:w-72 px-4 py-2 rounded-lg bg-slate-950/80 border border-slate-700 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-cyan-500"
          />
          <div class="text-xs text-slate-400 self-end sm:self-center">
            Showing 1 to 4 entries
          </div>
        </div>

        <!-- Pricing Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-800 text-xs font-semibold uppercase tracking-wider text-slate-400">
                <th class="py-3 px-4">Domain Extension</th>
                <th class="py-3 px-4">Category</th>
                <th class="py-3 px-4">Register</th>
                <th class="py-3 px-4">Renew</th>
                <th class="py-3 px-4">Transfer</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 text-sm">
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-4 px-4 font-bold text-white flex items-center gap-2">
                  .co.za <span class="px-2 py-0.5 text-[10px] uppercase font-extrabold bg-red-950/80 text-red-400 border border-red-500/30 rounded-md">Hot</span>
                </td>
                <td class="py-4 px-4 text-slate-400">Popular</td>
                <td class="py-4 px-4 font-bold text-cyan-400">R75</td>
                <td class="py-4 px-4 text-slate-300">R85</td>
                <td class="py-4 px-4 text-slate-300">R85</td>
              </tr>
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-4 px-4 font-bold text-white flex items-center gap-2">
                  .com <span class="px-2 py-0.5 text-[10px] uppercase font-extrabold bg-red-950/80 text-red-400 border border-red-500/30 rounded-md">Hot</span>
                </td>
                <td class="py-4 px-4 text-slate-400">Popular</td>
                <td class="py-4 px-4 font-bold text-cyan-400">R200</td>
                <td class="py-4 px-4 text-slate-300">R230</td>
                <td class="py-4 px-4 text-slate-300">R215</td>
              </tr>
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-4 px-4 font-bold text-white flex items-center gap-2">
                  .org.za <span class="px-2 py-0.5 text-[10px] uppercase font-extrabold bg-emerald-950/80 text-emerald-400 border border-emerald-500/30 rounded-md">Sale</span>
                </td>
                <td class="py-4 px-4 text-slate-400">Popular</td>
                <td class="py-4 px-4 font-bold text-cyan-400">R95</td>
                <td class="py-4 px-4 text-slate-300">R110</td>
                <td class="py-4 px-4 text-slate-300">R110</td>
              </tr>
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-4 px-4 font-bold text-white flex items-center gap-2">
                  .net <span class="px-2 py-0.5 text-[10px] uppercase font-extrabold bg-red-950/80 text-red-400 border border-red-500/30 rounded-md">Hot</span>
                </td>
                <td class="py-4 px-4 text-slate-400">Popular</td>
                <td class="py-4 px-4 font-bold text-cyan-400">R200</td>
                <td class="py-4 px-4 text-slate-300">R284</td>
                <td class="py-4 px-4 text-slate-300">R284</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <p class="text-xs text-slate-500 text-right">All prices in ZAR. VAT included.</p>
    </section>

    <!-- 4. HOW IT WORKS & INFORMATION SECTION -->
    <section class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Process Steps & Banner -->
      <div class="lg:col-span-5 space-y-8">
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">How It Works</h2>
          <ol class="space-y-4 text-sm text-slate-300">
            <li class="p-4 rounded-xl bg-slate-900/50 border border-slate-800">
              <strong class="text-cyan-400 block text-base mb-1">1) Search Your Domain</strong>
              Enter your ideal name in our search tool to verify instant availability.
            </li>
            <li class="p-4 rounded-xl bg-slate-900/50 border border-slate-800">
              <strong class="text-cyan-400 block text-base mb-1">2) Select Your Extension</strong>
              Lock in your domain extension before someone else claims your brand.
            </li>
            <li class="p-4 rounded-xl bg-slate-900/50 border border-slate-800">
              <strong class="text-cyan-400 block text-base mb-1">3) Complete Checkout</strong>
              Pay securely via Instant EFT or card with clear, upfront pricing.
            </li>
            <li class="p-4 rounded-xl bg-slate-900/50 border border-slate-800">
              <strong class="text-cyan-400 block text-base mb-1">4) Launch & Manage</strong>
              Connect your domain to hosting or email within your management dashboard.
            </li>
          </ol>
        </div>

        <!-- Promo Callout Banner -->
        <div class="p-6 rounded-2xl bg-gradient-to-br from-cyan-950/80 to-slate-900 border border-cyan-500/40 glassmorphism space-y-4">
          <h3 class="text-xl font-bold text-white">Transparent Renewals for .CO.ZA</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            While some registrars lure you with low upfront costs only to charge excessive renewal fees later, we maintain honest, affordable pricing year after year.
          </p>
          <ul class="text-xs text-cyan-300 space-y-1.5 font-medium">
            <li>✔ Low initial registration rates</li>
            <li>✔ Predictable annual renewal pricing</li>
            <li>✔ Zero hidden administration fees</li>
          </ul>
        </div>
      </div>

      <!-- Right Column: Search Tips Guide -->
      <div class="lg:col-span-7 p-8 rounded-2xl bg-slate-900/50 border border-slate-800 glassmorphism space-y-6">
        <h3 class="text-2xl font-bold text-white">Finding the Perfect Domain in South Africa</h3>
        <p class="text-sm text-slate-300 leading-relaxed">
          Choosing the right domain extension is a critical first step for building your online presence. South Africa’s digital landscape offers several strong TLD options depending on your market focus:
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs font-semibold text-cyan-400">
          <div class="p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 text-center">.co.za</div>
          <div class="p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 text-center">.org.za</div>
          <div class="p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 text-center">.net.za</div>
          <div class="p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 text-center">.com</div>
          <div class="p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 text-center">.africa</div>
          <div class="p-2.5 rounded-lg bg-slate-950/60 border border-slate-800 text-center">.shop</div>
        </div>

        <div class="space-y-3 pt-2">
          <h4 class="font-bold text-white text-base">Key Factors to Consider:</h4>
          <ul class="list-disc list-inside text-sm text-slate-300 space-y-2">
            <li><strong>Local SEO Advantage:</strong> A `.co.za` domain boosts search rankings within South African query results.</li>
            <li><strong>Brand Match & Length:</strong> Keep your name concise, clear, and easy to communicate verbally.</li>
            <li><strong>Extension Purpose:</strong> Match the TLD to your industry (e.g., `.shop` for e-commerce, `.org.za` for non-profits).</li>
          </ul>
        </div>
      </div>

    </section>

    <!-- 5. POPULAR EXTENSIONS GUIDE -->
    <section class="max-w-6xl mx-auto space-y-8">
      <h2 class="text-3xl font-bold text-white">Popular Extensions Overview</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800 flex gap-4 items-start">
          <span class="text-cyan-400 font-extrabold text-xl">.co.za</span>
          <div>
            <h3 class="font-bold text-white text-sm">South African Standard</h3>
            <p class="text-xs text-slate-400 mt-1">The primary choice for local businesses targeting South African audiences.</p>
          </div>
        </div>

        <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800 flex gap-4 items-start">
          <span class="text-cyan-400 font-extrabold text-xl">.com</span>
          <div>
            <h3 class="font-bold text-white text-sm">Global Recognition</h3>
            <p class="text-xs text-slate-400 mt-1">The international gold standard for commercial and cross-border brands.</p>
          </div>
        </div>

        <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800 flex gap-4 items-start">
          <span class="text-cyan-400 font-extrabold text-xl">.africa</span>
          <div>
            <h3 class="font-bold text-white text-sm">Pan-African Reach</h3>
            <p class="text-xs text-slate-400 mt-1">Ideal for expanding operations across multiple African regions.</p>
          </div>
        </div>

        <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800 flex gap-4 items-start">
          <span class="text-cyan-400 font-extrabold text-xl">.shop</span>
          <div>
            <h3 class="font-bold text-white text-sm">E-Commerce Ready</h3>
            <p class="text-xs text-slate-400 mt-1">A modern, descriptive extension built specifically for online stores.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- 6. CALL TO ACTION & FAQ -->
    <section class="max-w-4xl mx-auto space-y-16">
      
      <!-- Call to Action Banner -->
      <div class="p-8 rounded-2xl bg-slate-900/90 border border-cyan-500/30 glassmorphism text-center space-y-4">
        <h2 class="text-3xl font-extrabold text-white">Secure Your Brand Name Today</h2>
        <p class="text-slate-400 text-sm max-w-lg mx-auto">
          Don't wait until someone else registers your domain. Check availability and activate yours immediately.
        </p>
        <a href="#domain-search-form" class="inline-block px-8 py-3 rounded-xl bg-cyan-600 hover:bg-cyan-500 font-bold text-white transition-all">
          Search Domains Now
        </a>
      </div>

      <!-- FAQ Accordion Container -->
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-center text-white">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800">
            <h3 class="font-semibold text-white">How quickly is my domain activated?</h3>
            <p class="text-sm text-slate-400 mt-2">Domain registrations are processed promptly following payment verification, with most `.co.za` domains going live within 24 hours.</p>
          </div>
          <div class="p-5 rounded-xl bg-slate-900/60 border border-slate-800">
            <h3 class="font-semibold text-white">Do I retain full ownership of my domain?</h3>
            <p class="text-sm text-slate-400 mt-2">Yes, you maintain 100% ownership and control over your domain name and DNS configuration at all times.</p>
          </div>
        </div>
      </div>

    </section>

  </main>
</Layout>