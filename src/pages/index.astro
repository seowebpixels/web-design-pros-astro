---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import LocalValue from '../components/LocalValue.astro';
import MetricsBar from '../components/MetricsBar.astro';
import Process from '../components/Process.astro';
import Portfolio from '../components/Portfolio.astro';
import CTA from '../components/CTA.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import AreasWeServe from '../components/AreasWeServe.astro';
import ServicesGrid from "../components/ServicesGrid.astro";
import GrowthModal from '../components/GrowthModal.astro';
import DomainSection from '../components/DomainSection.astro'
---

<Layout title="Web Design Pros | High-Performance Custom Web Design Gauteng">
  <main>
    <!-- Core Local Value & Positioning -->
    <LocalValue />

    <!--Detailed Services Portfoilio -->
    <ServicesGrid />

    <!--Package Selector -->
    <GrowthModal />

    <!-- Problem & Solution Statement -->
    <ProblemSolution />

     <!--Service Areas -->
    <AreasWeServe />

    <!-- Performance & Speed Statistics -->
    <MetricsBar />

    <!-- 4-Step Process & Workflow -->
    <Process />

    <!-- Featured Custom-Coded Projects -->
    <Portfolio />

    <!-- Transparent Web Design & WaaS Pricing -->
    <Pricing />

    <!--Interactive Domain Checker -->
    <DomainSection />

    <!-- Interactive Contact Form & CTA -->
    <CTA />
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    overflow-x: hidden;
  }
</style>