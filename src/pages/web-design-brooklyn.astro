---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';

const localNeeds = [
  {
    icon: '🛍️',
    title: 'Retail and Hospitality Need to Be Found Fast',
    description: "Someone deciding where to eat or shop in Brooklyn is often searching on a phone minutes before they arrive. A slow site or one that's hard to read on mobile is a real handicap in that moment, not a minor annoyance."
  },
  {
    icon: '🍽️',
    title: 'Menus, Hours and Stock Need to Stay Current',
    description: "Restaurants and independent retailers near a busy precinct change specials, hours and stock often. A site that's painful to update tends to simply stop being updated, and visitors notice the gap between the shopfront and the site."
  },
  {
    icon: '💼',
    title: 'Office-Based Firms Compete on a Slower Decision',
    description: "The consultancies and professional offices sharing the same streets as Brooklyn's retail strip are usually chosen after more deliberate research. Their sites need to do a different job entirely — build confidence over several visits, not create urgency in one."
  },
  {
    icon: '🎓',
    title: "Close to Hatfield's Student and Young-Professional Traffic",
    description: "Brooklyn sits near the University of Pretoria's Hatfield campus, which brings a steady flow of students and young professionals through the area — an audience that checks a phone before it checks a shopfront window."
  }
];
---

<Layout
  title="Web Design in Brooklyn, Pretoria | Web Design Pros"
  description="Web design for Brooklyn Pretoria's mix of retail, hospitality and office-based businesses — built for fast mobile discovery and considered professional research alike."
  canonical="https://webdesignpros.co.za/web-design-brooklyn"
>
  <section class="area-hero">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WEB DESIGN IN BROOKLYN</span>
        <h1 class="section-title">Web Design for Brooklyn's Retail, Hospitality and Office Mix</h1>
        <p class="section-intro">
          Brooklyn mixes retail and restaurants clustered around its shopping precinct with office-based professional and consulting firms along the surrounding streets. Those two kinds of business are chosen in very different ways, and a website built for one rarely serves the other well.
        </p>
      </div>
    </div>
  </section>

  <section class="context-section">
    <div class="container">
      <div class="context-card">
        <h2>Two Different Buying Moments, One Suburb</h2>
        <p>
          A Brooklyn café or independent retailer is usually chosen in the moment — a quick phone search for somewhere nearby to eat or buy something specific, often while already close by or on the way. An office-based consultancy on the same streets is chosen much more slowly, after a prospective client has read a bit about the firm and quietly compared it to others. A website that tries to do both jobs at once — urgency and reassurance — usually does neither particularly well.
        </p>
      </div>
    </div>
  </section>

  <section class="needs-section">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WHAT THIS MEANS FOR YOUR SITE</span>
        <h2 class="section-title-h2">Built for However Brooklyn Customers Actually Decide</h2>
      </div>
      <div class="needs-grid">
        {localNeeds.map((item) => (
          <div class="need-card">
            <div class="card-icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hypothetical-section">
    <div class="container">
      <div class="hypothetical-card">
        <span class="hypothetical-label">Illustrative example — not a real client case study</span>
        <h2>How We'd Approach a Brooklyn Café or Independent Retailer</h2>
        <p>
          Suppose a Brooklyn café or boutique retailer relying on passing foot traffic near the local shopping precinct, with an outdated social media page as its only real online presence. The priority here isn't a broad rebuild — it's a fast, mobile-first site with current hours, menu or stock, and clear directions, so someone deciding where to go in the next five minutes can actually find and choose the business.
        </p>
      </div>
    </div>
  </section>

  <section class="local-links-section">
    <div class="container">
      <p>
        See our <a href="/pricing">website packages and pricing</a>, browse <a href="/#portfolio">recent project work</a>, or view <a href="/#areas">all Gauteng areas we serve</a>.
      </p>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .area-hero {
    padding: 5rem 2rem 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .container {
    width: 100%;
  }

  .section-header {
    text-align: center;
    width: 100%;
    max-width: 850px;
    margin: 0 auto 3rem auto;
  }

  .sub-heading {
    color: var(--accent-secondary, #89CFF0);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .section-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    line-height: 1.15;
    white-space: normal;
  }

  .section-title-h2 {
    font-size: 2.25rem;
    color: #ffffff;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .section-intro {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.6;
    max-width: 750px;
    margin: 0 auto;
  }

  .context-section,
  .needs-section,
  .hypothetical-section {
    padding: 2rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .context-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .context-card h2 {
    font-size: 1.75rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .context-card p {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .needs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 1024px) {
    .needs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .need-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .need-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-primary, #0096FF);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .need-card h3 {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .need-card p {
    font-size: 0.875rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.55;
  }

  .hypothetical-card {
    background: rgba(0, 150, 255, 0.04);
    border: 1px solid rgba(0, 150, 255, 0.2);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .hypothetical-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--accent-secondary, #89CFF0);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .hypothetical-card h2 {
    font-size: 1.6rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .hypothetical-card p {
    font-size: 0.95rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .local-links-section {
    padding: 1rem 2rem 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .local-links-section p {
    font-size: 0.9rem;
    color: rgba(230, 230, 230, 0.7);
  }

  .local-links-section a {
    color: var(--accent-primary, #0096FF);
    text-decoration: underline;
  }

  .local-links-section a:hover {
    color: var(--accent-secondary, #89CFF0);
  }
</style>
