---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';

const localNeeds = [
  {
    icon: '🏛️',
    title: 'A Site That Matches an Established Reputation',
    description: "Many Waterkloof medical, legal and financial practices have operated for decades largely on referral. A dated or generic-looking website can quietly undersell that track record before a prospective client has read a single word."
  },
  {
    icon: '🤫',
    title: 'Discretion Before Marketing Flourish',
    description: 'For practices dealing with sensitive medical, legal or financial matters, a calm, clearly organised site that respects client privacy expectations does more good than flashy visuals or aggressive calls to action.'
  },
  {
    icon: '🔍',
    title: 'Referral Still Starts With a Search',
    description: "Even when a new client arrives by personal referral, they usually check the practice online first. A thin, outdated or missing website can undercut that referral before the first call is ever made."
  },
  {
    icon: '🛡️',
    title: "Neighbouring Pretoria's Diplomatic Precinct",
    description: "Waterkloof sits close to Pretoria's cluster of embassies and diplomatic missions. Businesses nearby often deal with a more security- and privacy-conscious clientele than a typical retail suburb, and a website should carry the same restraint."
  }
];
---

<Layout
  title="Web Design in Waterkloof, Pretoria | Web Design Pros"
  description="Web design for Waterkloof's established medical, legal and financial practices — built to match decades of reputation with the same discretion they already bring offline."
  canonical="https://webdesignpros.co.za/web-design-waterkloof"
>
  <section class="area-hero">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WEB DESIGN IN WATERKLOOF</span>
        <h1 class="section-title">Web Design for Waterkloof's Established Professional Practices</h1>
        <p class="section-intro">
          Waterkloof is home to a concentration of long-established medical, legal and financial practices, many built almost entirely on personal referral over years or decades. A website here has a different job to do than a typical retail site — it needs to reflect a reputation that's already earned, not manufacture one from scratch.
        </p>
      </div>
    </div>
  </section>

  <section class="context-section">
    <div class="container">
      <div class="context-card">
        <h2>A Suburb Built on Reputation and Referral</h2>
        <p>
          A specialist medical practice, attorney, or financial advisor in Waterkloof rarely wins new clients through cold marketing — most arrive through a referral from another client, doctor, or colleague. That doesn't make a website optional, though. Before that first call is made, most prospective clients quietly check the practice online, and what they find either confirms the referral or plants a doubt. The website's job isn't to persuade a stranger; it's to not let a warm introduction go cold.
        </p>
      </div>
    </div>
  </section>

  <section class="needs-section">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WHAT THIS MEANS FOR YOUR SITE</span>
        <h2 class="section-title-h2">Built to Carry an Existing Reputation Online</h2>
      </div>
      <div class="needs-grid">
        {localNeeds.map((item) => (
          <div class="need-card">
            <div class="card-icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hypothetical-section">
    <div class="container">
      <div class="hypothetical-card">
        <span class="hypothetical-label">Illustrative example — not a real client case study</span>
        <h2>How We'd Approach a Waterkloof Specialist Practice</h2>
        <p>
          Suppose a Waterkloof-based specialist medical or legal practice that has built its client base over twenty-plus years almost entirely through word of mouth, with a website that hasn't been touched since it first went up. The right approach here isn't a flashy rebuild — it's a clear, calm site that surfaces credentials, registration details, and a straightforward way to get in touch, without turning decades of quiet trust into something that reads like a sales page.
        </p>
      </div>
    </div>
  </section>

  <section class="local-links-section">
    <div class="container">
      <p>
        See our <a href="/pricing">website packages and pricing</a>, browse <a href="/#portfolio">recent project work</a>, or view <a href="/#areas">all Gauteng areas we serve</a>.
      </p>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .area-hero {
    padding: 5rem 2rem 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .container {
    width: 100%;
  }

  .section-header {
    text-align: center;
    width: 100%;
    max-width: 850px;
    margin: 0 auto 3rem auto;
  }

  .sub-heading {
    color: var(--accent-secondary, #89CFF0);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .section-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    line-height: 1.15;
    white-space: normal;
  }

  .section-title-h2 {
    font-size: 2.25rem;
    color: #ffffff;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .section-intro {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.6;
    max-width: 750px;
    margin: 0 auto;
  }

  .context-section,
  .needs-section,
  .hypothetical-section {
    padding: 2rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .context-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .context-card h2 {
    font-size: 1.75rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .context-card p {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .needs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 1024px) {
    .needs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .need-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .need-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-primary, #0096FF);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .need-card h3 {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .need-card p {
    font-size: 0.875rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.55;
  }

  .hypothetical-card {
    background: rgba(0, 150, 255, 0.04);
    border: 1px solid rgba(0, 150, 255, 0.2);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .hypothetical-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--accent-secondary, #89CFF0);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .hypothetical-card h2 {
    font-size: 1.6rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .hypothetical-card p {
    font-size: 0.95rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .local-links-section {
    padding: 1rem 2rem 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .local-links-section p {
    font-size: 0.9rem;
    color: rgba(230, 230, 230, 0.7);
  }

  .local-links-section a {
    color: var(--accent-primary, #0096FF);
    text-decoration: underline;
  }

  .local-links-section a:hover {
    color: var(--accent-secondary, #89CFF0);
  }
</style>
