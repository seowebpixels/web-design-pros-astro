---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';

const localNeeds = [
  {
    icon: '🚗',
    title: "Customers Travel Here on Purpose — Help Them Decide Before They Do",
    description: "When a customer is deliberately travelling from elsewhere in Johannesburg for a specific product or range, the website's job is to give them enough confidence in stock, pricing, and reputation to make that trip worthwhile."
  },
  {
    icon: '📦',
    title: 'Catalogues and Stock Ranges Belong Online',
    description: "A trading business built around a wide product range benefits from showing that range online — even a straightforward catalogue-style presentation gives a visiting or wholesale customer a reason to choose one supplier over another before ever arriving."
  },
  {
    icon: '🤝',
    title: 'Wholesale Buyers Need a Different Path Than Retail Shoppers',
    description: "A business serving both individual customers and bulk or trade buyers often needs distinct, clear ways for each to get what they need — a wholesale enquiry shouldn't be buried inside a retail-facing contact form."
  },
  {
    icon: '🖼️',
    title: 'Visual Product Presentation Matters More Than Long-Form Copy',
    description: "In product-led trading businesses, clear photography and an easy-to-browse layout usually do more work than descriptive paragraphs — the site should be built to show the range, not just describe it."
  }
];
---

<Layout
  title="Web Design in Lenasia | Web Design Pros"
  description="Web design for Lenasia's retail and wholesale trading businesses — built around a regional customer base and product-led browsing rather than long-form copy."
  canonical="https://webdesignpros.co.za/web-design-lenasia"
>
  <section class="area-hero">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WEB DESIGN IN LENASIA</span>
        <h1 class="section-title">Web Design for Lenasia's Retail & Wholesale Trading Businesses</h1>
        <p class="section-intro">
          Lenasia has long functioned as a well-known regional trading and retail destination, particularly for textiles, fashion, and wholesale goods — drawing customers from well beyond the immediate area rather than relying on passing local foot traffic alone.
        </p>
      </div>
    </div>
  </section>

  <section class="context-section">
    <div class="container">
      <div class="context-card">
        <h2>A Trading Destination, Not Just a Local Shopping Strip</h2>
        <p>
          Where many suburbs serve mostly their own immediate residents, Lenasia's retail and wholesale trade draws customers who are travelling there specifically for a particular product range or price point. That changes the job a website needs to do: it's less about local proximity search and more about giving a customer who's already decided to make the trip enough confidence in range, stock, and value to choose one trader over another before they arrive.
        </p>
      </div>
    </div>
  </section>

  <section class="needs-section">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WHAT THIS MEANS FOR YOUR SITE</span>
        <h2 class="section-title-h2">Built for a Product-Led, Regional Customer Base</h2>
      </div>
      <div class="needs-grid">
        {localNeeds.map((item) => (
          <div class="need-card">
            <div class="card-icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hypothetical-section">
    <div class="container">
      <div class="hypothetical-card">
        <span class="hypothetical-label">Illustrative example — not a real client case study</span>
        <h2>How We'd Approach a Lenasia Retail or Wholesale Trading Business</h2>
        <p>
          It's common to find a Lenasia fabric or clothing wholesaler relying entirely on in-person visits and word of mouth, with no way for a prospective buyer to see stock or ranges beforehand. A useful build here focuses on a clean, browsable product presentation and a clearly separated path for wholesale enquiries, so a buyer can arrive already confident the trip is worth making, rather than gambling on it.
        </p>
      </div>
    </div>
  </section>

  <section class="local-links-section">
    <div class="container">
      <p>
        See our <a href="/pricing">website packages and pricing</a>, browse <a href="/#portfolio">recent project work</a>, or view <a href="/#areas">all Gauteng areas we serve</a>.
      </p>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .area-hero {
    padding: 5rem 2rem 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .container {
    width: 100%;
  }

  .section-header {
    text-align: center;
    width: 100%;
    max-width: 850px;
    margin: 0 auto 3rem auto;
  }

  .sub-heading {
    color: var(--accent-secondary, #89CFF0);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .section-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    line-height: 1.15;
    white-space: normal;
  }

  .section-title-h2 {
    font-size: 2.25rem;
    color: #ffffff;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .section-intro {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.6;
    max-width: 750px;
    margin: 0 auto;
  }

  .context-section,
  .needs-section,
  .hypothetical-section {
    padding: 2rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .context-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .context-card h2 {
    font-size: 1.75rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .context-card p {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .needs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 1024px) {
    .needs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .need-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .need-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-primary, #0096FF);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .need-card h3 {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .need-card p {
    font-size: 0.875rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.55;
  }

  .hypothetical-card {
    background: rgba(0, 150, 255, 0.04);
    border: 1px solid rgba(0, 150, 255, 0.2);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .hypothetical-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--accent-secondary, #89CFF0);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .hypothetical-card h2 {
    font-size: 1.6rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .hypothetical-card p {
    font-size: 0.95rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .local-links-section {
    padding: 1rem 2rem 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .local-links-section p {
    font-size: 0.9rem;
    color: rgba(230, 230, 230, 0.7);
  }

  .local-links-section a {
    color: var(--accent-primary, #0096FF);
    text-decoration: underline;
  }

  .local-links-section a:hover {
    color: var(--accent-secondary, #89CFF0);
  }
</style>
