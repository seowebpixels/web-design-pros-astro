---
export const prerender=true;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
const packages=[
  {name:'Starter',price:'R4 000',number:'01',description:'A professional first website for small businesses ready to make their mark online.',tag:'YOUR FIRST STEP ONLINE',icon:'starter'},
  {name:'Website Redesign',price:'R6 000',number:'02',description:'Refresh your existing website with modern design, faster pages and a better mobile experience.',tag:'A FRESH START',icon:'redesign'},
  {name:'Business Website',price:'R9 500',number:'03',description:'Showcase your services, build credibility and turn more visitors into enquiries.',tag:'ROOM TO GROW',icon:'business'},
  {name:'E-Commerce Website',price:'R17 000',number:'04',description:'Bring your products online with an easy-to-browse store and a smooth, secure checkout.',tag:'OPEN FOR BUSINESS',icon:'store'}
];
const stats=[{label:'Services',value:'—',href:'/dashboard/services/',icon:'server'},{label:'Domains',value:'0',href:'/dashboard/domains/',icon:'globe'},{label:'Unpaid invoices',value:'0',href:'/dashboard/billing/',icon:'invoice'},{label:'Orders',value:'—',href:'/dashboard/orders/',icon:'orders'}];
---
<DashboardLayout title="My Dashboard | Web Design Pros" activeNav="dashboard">
  <header class="page-heading"><h1>My Dashboard</h1><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Portal home</a><span aria-hidden="true">/</span><span>Client area</span></nav></header>
  <div class="dashboard-grid">
    <aside class="customer-sidebar" aria-label="Your account">
      <section class="customer-card">
        <span class="customer-avatar" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><circle cx="16" cy="11" r="5" stroke="currentColor" stroke-width="1.8"/><path d="M6 27c0-6 4-9 10-9s10 3 10 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
        <h2 id="dashboard-profile-name">Your account</h2><p id="dashboard-profile-address" class="customer-address">Loading your details…</p>
        <div class="customer-actions"><a href="/dashboard/profile/">Update details</a><button type="button" data-dashboard-logout>Sign out</button></div>
      </section>
      <section class="sidebar-section"><h2>Shortcuts</h2><a href="/pricing/"><span aria-hidden="true">↗</span> Explore website packages</a><a href="/domains/"><span aria-hidden="true">◎</span> Register a new domain</a><a href="/dashboard/orders/"><span aria-hidden="true">▤</span> My orders</a><a href="/contact/"><span aria-hidden="true">↗</span> Contact support</a></section>
      <section class="sidebar-help"><span class="eyebrow">LET’S BUILD SOMETHING</span><h2>Not sure where to start?</h2><p>Tell us what you have in mind. We’ll help you find the right fit.</p><a href="/contact/">Talk to WDP →</a></section>
    </aside>
    <div class="dashboard-main">
      <section class="summary-cards" aria-label="Account overview">{stats.map(stat=><a class="summary-card" href={stat.href}><span class="summary-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">{stat.icon==='server'?<><rect x="3" y="4" width="18" height="6" rx="2"/><rect x="3" y="14" width="18" height="6" rx="2"/><path d="M7 7h.01M7 17h.01M11 7h6M11 17h6"/></>:stat.icon==='globe'?<><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></>:stat.icon==='invoice'?<><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h5"/></>:<><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4M16 3v4M8 12h8M8 16h5"/></>}</svg></span><strong id={stat.icon==='orders'?'dashboard-order-count':stat.icon==='server'?'dashboard-service-count':stat.icon==='globe'?'dashboard-domain-count':undefined}>{stat.value}</strong><span class="summary-label">{stat.label}</span>{stat.icon==='globe'&&<small id="dashboard-domain-note" class="summary-note" hidden></small>}</a>)}</section>
      <section class="website-packages" aria-labelledby="packages-heading">
        <div class="section-heading"><div><p class="eyebrow">A WEBSITE THAT WORKS FOR YOU</p><h2 id="packages-heading">Your next chapter starts here.</h2><p>From your first website to your next big move. Find your perfect starting point.</p></div><a class="pricing-link" href="/pricing/">Compare packages →</a></div>
        <div class="package-grid">{packages.map(pkg=><article class:list={['package-card',`package-${pkg.icon}`]}><div class="package-top"><span class="package-number">{pkg.number}</span><span class="package-tag">{pkg.tag}</span></div><h3>{pkg.name}</h3><p class="package-description">{pkg.description}</p><div class="package-bottom"><strong>{pkg.price}</strong><a href={`/contact/?package=${encodeURIComponent(pkg.name)}`} aria-label={`Enquire about the ${pkg.name} package`}>Let’s talk <span aria-hidden="true">↗</span></a></div></article>)}</div>
      </section>
      <div class="dashboard-extras"><section class="extra-card domain-card"><span class="eyebrow">MAKE IT YOURS</span><h2>Find your next domain.</h2><p>A great idea deserves a great address. Search for a name that belongs to you.</p><a href="/domains/">Search domains →</a></section><section class="extra-card"><span class="eyebrow">WE’RE HERE TO HELP</span><h2>Let’s keep you moving.</h2><p>Questions about your website, hosting or next project? Your WDP team is a message away.</p><a href="/contact/">Get in touch →</a></section></div>
    </div>
  </div>
</DashboardLayout>
<style>
  .page-heading{margin-bottom:42px}.page-heading h1{margin:0 0 14px}.breadcrumb{display:flex;gap:10px;color:var(--text-muted);font-size:.8rem}.breadcrumb a{text-decoration:none}.dashboard-grid{display:grid;grid-template-columns:260px minmax(0,1fr);gap:32px;align-items:start}.customer-sidebar,.dashboard-main{min-width:0}.customer-card{background:linear-gradient(145deg,#008bfa,#045ad2 50%,#063b9f);padding:26px 24px 28px;border-radius:10px;box-shadow:0 12px 32px #00102c30}.customer-avatar{display:grid;place-items:center;width:64px;height:64px;border-radius:50%;background:#ffffff1c;border:1px solid #ffffff26}.customer-avatar svg{width:36px;height:36px}.customer-card h2{font-size:1.65rem;margin:20px 0 24px;overflow-wrap:anywhere;font-weight:500}.customer-address{font-size:.83rem;line-height:1.9;white-space:pre-line;min-height:72px;margin-bottom:24px;overflow-wrap:anywhere}.customer-actions{display:flex;gap:10px;flex-wrap:wrap}.customer-actions a,.customer-actions button{border:1px solid #ffffff47;border-radius:6px;padding:9px 12px;font:inherit;font-size:.72rem;text-decoration:none;cursor:pointer}.customer-actions a{background:#e3f2ff;color:#004dbb;border-color:#e3f2ff}.customer-actions button{background:transparent;color:white}.sidebar-section{padding:28px 2px}.sidebar-section h2{font-size:1.25rem;font-weight:500;margin:0 0 20px}.sidebar-section a{display:flex;gap:12px;align-items:baseline;text-decoration:none;font-size:.78rem;margin:15px 0}.sidebar-section a span{color:#0096ff}.sidebar-help{padding:24px;border:1px solid var(--border-color);border-top:3px solid #0096ff;border-radius:8px;background:#1b2946}.sidebar-help h2{font-size:1.4rem;margin:16px 0}.sidebar-help p{font-size:.8rem;color:var(--text-muted)}.sidebar-help a{font-size:.8rem;font-weight:600;text-decoration:none}.eyebrow{font-size:.63rem;letter-spacing:1.6px;font-weight:700;color:#89cfff;margin:0 0 12px}.summary-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.summary-card{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:180px;padding:30px 12px 22px;border:1px solid var(--border-color);border-radius:10px;background:var(--bg-card);text-decoration:none;color:var(--text-main);box-shadow:0 8px 24px #00102b15;transition:border-color .15s,transform .15s}.summary-card:hover{border-color:#6abcf3;transform:translateY(-2px)}.summary-card strong{font-family:var(--font-heading);font-size:3.4rem;line-height:1.1;font-weight:500;color:#4bb5ff}.summary-label{margin-top:12px;font-size:.8rem;text-align:center}.summary-note{margin-top:6px;font-size:.7rem;color:#ffca6b}.summary-icon{position:absolute;right:16px;top:15px;color:#8ea6c4}.summary-icon svg{width:18px;height:18px}.website-packages{margin-top:38px}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:22px}.section-heading h2{font-size:1.75rem;margin:0 0 12px;letter-spacing:-.5px}.section-heading p:last-child{color:var(--text-muted);font-size:.8rem;margin:0;max-width:490px}.pricing-link{font-size:.75rem;white-space:nowrap;text-decoration:none}.package-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.package-card{position:relative;padding:25px 26px 24px;border:1px solid var(--border-color);border-radius:10px;background:#1b2946;overflow:hidden}.package-card::before{content:'';position:absolute;inset:0 auto 0 0;width:3px;background:#0096ff}.package-redesign::before{background:#79cfff}.package-business::before{background:#fc9d3c}.package-store::before{background:#55d6b0}.package-top{display:flex;align-items:center;justify-content:space-between;gap:16px}.package-number{color:#697f9c;font-size:.75rem}.package-tag{font-size:.55rem;letter-spacing:1.2px;color:#a8c4e2}.package-card h3{font-size:1.55rem;font-weight:700;letter-spacing:-.3px;margin:24px 0 12px}.package-description{font-size:.8rem;color:var(--text-muted);line-height:1.8;min-height:68px;margin:0 0 24px;max-width:340px}.package-bottom{display:flex;justify-content:space-between;align-items:center;gap:14px;padding-top:20px;border-top:1px solid #35445f}.package-bottom strong{font:700 1.6rem var(--font-heading);letter-spacing:-.5px}.package-bottom a{display:flex;align-items:center;gap:14px;font-size:.72rem;font-weight:600;text-decoration:none}.package-bottom a span{display:grid;place-items:center;border:1px solid #405773;border-radius:50%;width:30px;height:30px;font-size:.9rem}.dashboard-extras{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px}.extra-card{border:1px solid var(--border-color);border-radius:10px;padding:26px;background:#1b2946}.extra-card h2{font-size:1.4rem;margin:15px 0}.extra-card p{color:var(--text-muted);font-size:.8rem;line-height:1.8;margin-bottom:22px}.extra-card a{font-size:.8rem;text-decoration:none;font-weight:600}.domain-card{background:linear-gradient(135deg,#203a5e,#1b2946)}
  @media(max-width:1100px){.dashboard-grid{grid-template-columns:230px minmax(0,1fr);gap:24px}.summary-cards{gap:12px}.summary-card{min-height:150px}.summary-card strong{font-size:2.7rem}.summary-label{font-size:.7rem}.package-card{padding:22px}.section-heading{display:block}.pricing-link{display:inline-block;margin-top:15px}}
  @media(max-width:850px){.dashboard-grid{grid-template-columns:1fr}.customer-sidebar{display:grid;grid-template-columns:1fr 1fr;gap:22px}.customer-card{grid-row:span 2}.sidebar-section{padding:5px 0}.sidebar-help{padding:20px}.summary-card{min-height:150px}.website-packages{margin-top:32px}}
  @media(max-width:550px){.page-heading{margin-bottom:28px}.customer-sidebar{grid-template-columns:1fr}.customer-card{grid-row:auto}.customer-address{min-height:0}.sidebar-section,.sidebar-help{display:none}.summary-cards{grid-template-columns:repeat(2,minmax(0,1fr))}.summary-card{min-height:145px}.summary-card strong{font-size:3rem}.summary-label{font-size:.8rem}.package-grid,.dashboard-extras{grid-template-columns:1fr}.section-heading h2{font-size:1.7rem}.package-description{min-height:0}.package-card h3{font-size:1.65rem}}
</style>
