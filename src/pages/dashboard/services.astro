---
export const prerender = true;
import DashboardLayout from '../../layouts/DashboardLayout.astro';

---

<DashboardLayout title="My Services - Web Design Pros" activeNav="services">
  <div class="page-header">
    <div>
      <h1>My Services</h1>
      <p class="subtitle">Manage your domain purchases, hosting and website services</p>
    </div>
    <div class="actions">
      <a href="/pricing/" class="btn-primary">+ Order New Service</a>
    </div>
  </div>

  <div class="services-grid">
    <!-- Left Sidebar -->
    <aside class="sidebar-card">
      <h3 class="sidebar-title">Service Actions</h3>
      <nav class="sidebar-nav">
        <a href="/dashboard/services" class="sidebar-link active">My Services</a>
        <a href="/pricing/" class="sidebar-link">Browse Plans</a>
      </nav>
    </aside>

    <!-- Main Content: Services Table -->
    <section class="main-content" aria-label="Your services">
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Product / Service</th>
              <th>Domain</th>
              <th>Price / Billing cycle</th>
              <th>Next Due Date</th>
              <th>Status</th>
              <th style="text-align: right;">Action</th>
            </tr>
          </thead>
          <tbody id="services-body"><tr><td colspan="6" class="empty-state">Loading your services…</td></tr></tbody>
        </table>
      </div>
    </section>
  </div>
<p id="services-status" role="status" aria-live="polite"></p><div class="service-controls"><button id="services-refresh" type="button" class="table-manage-btn">Refresh services</button><button id="services-more" type="button" class="table-manage-btn" hidden>Load more services</button></div></DashboardLayout>
<script>import '../../scripts/services';</script>

<style is:global>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .page-header h1 {
    margin: 0;
    font-size: 1.8rem;
    color: var(--text-main);
  }

  .subtitle {
    margin: 0.25rem 0 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .btn-primary {
    background: var(--accent-cyan);
    color: #001437;
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    display: inline-block;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 260px minmax(0,1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Sidebar */
  .sidebar-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.25rem;
  }

  .sidebar-title {
    margin: 0 0 1rem 0;
    font-size: 1rem;
    color: var(--text-main);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-link {
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.95rem;
  }

  .sidebar-link.active {
    background: #001437;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  /* Main Table */
  .table-container {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.95rem;
  }

  th {
    background: #001133;
    color: var(--text-muted);
    font-weight: 600;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-color);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.5px;
  }

  td {
    padding: 1rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-main);
  }

  tr:last-child td {
    border-bottom: none;
  }

  .product-name {
    font-weight: 600;
    color: var(--text-main);
  }

  .domain-link {
    color: var(--accent-cyan);
    font-weight: 500;
  }

  .price-val {
    font-weight: 600;
    color: var(--text-main);
  }

  .cycle-val {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .status-badge {
    padding: 0.25rem 0.6rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-block;
  }

  .status-badge.active {
    background: rgba(16, 185, 129, 0.15);
    color: #10B981;
    border: 1px solid #10B981;
  }

  .table-manage-btn {
    background: transparent;
    color: var(--accent-cyan);
    border: 1px solid var(--accent-cyan);
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .table-manage-btn:hover {
    background: rgba(0, 229, 255, 0.1);
  }

  .empty-state {
    text-align: center;
    color: var(--text-muted);
    padding: 2rem;
  }
small {display:block;color:var(--text-muted);font-size:.72rem;font-weight:400;margin-top:6px} .service-action{text-align:right} .table-manage-btn{text-decoration:none;display:inline-block} .status-badge.pending{background:#fbbf2412;color:#f8d286;border:1px solid #9b793d} .service-controls{display:flex;gap:14px;margin-top:20px} #services-status{color:var(--accent-cyan)} #services-status:empty{display:none}</style>