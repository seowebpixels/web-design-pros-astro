---
export const prerender=true;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import logo from '../../assets/wdp-logo-new-design-one.avif';
---
<DashboardLayout title="Invoice | Web Design Pros" activeNav="billing">
  <div class="invoice-actions"><a id="invoice-back" href="/dashboard/billing/">← All invoices</a><button id="invoice-print" type="button" disabled>Print / Save PDF</button></div>
  <p id="invoice-status" role="status" aria-live="polite">Loading your invoice…</p>
  <article id="invoice-paper" class="invoice-paper" hidden>
    <header class="invoice-heading"><div class="invoice-logo"><img src={logo.src} width={logo.width} height={logo.height} alt="Web Design Pros" /></div><div><h1 id="invoice-title">Invoice</h1><p id="invoice-reference"></p><span id="invoice-paid" class="paid-badge"></span></div></header>
    <p id="invoice-test-note" class="test-note" hidden>TEST INVOICE — No money has been charged. This document is a test record, not a tax invoice or proof of domain registration.</p>
    <div class="invoice-parties"><section><h2>From</h2><strong id="invoice-seller"></strong><p id="invoice-company-registration"></p><p id="invoice-seller-contact" class="multiline"></p></section><section><h2>Bill to</h2><strong id="invoice-customer"></strong><p id="invoice-customer-company"></p><p id="invoice-customer-contact" class="multiline"></p></section></div>
    <dl class="invoice-dates"><div><dt>Invoice date</dt><dd id="invoice-issued"></dd></div><div><dt>Payment confirmed</dt><dd id="invoice-payment-date"></dd></div><div><dt>Currency</dt><dd>ZAR</dd></div></dl>
    <div class="invoice-table"><table><thead><tr><th>Description</th><th>Period</th><th>Amount</th></tr></thead><tbody id="invoice-lines"></tbody></table></div>
    <dl class="invoice-totals"><div><dt>Total</dt><dd id="invoice-total"></dd></div><div><dt id="invoice-amount-paid-label">Amount paid</dt><dd id="invoice-amount-paid"></dd></div><div class="balance"><dt>Balance due</dt><dd id="invoice-balance"></dd></div></dl>
    <footer class="invoice-footer"><p>No VAT charged. Web Design Pros is not VAT registered.</p><p>Keep your WDP reference when contacting us about this purchase. Payment confirmation is separate from domain registration or hosting activation.</p><a id="invoice-order" href="/dashboard/orders/">View related order →</a></footer>
  </article>
</DashboardLayout>
<script>import '../../scripts/invoice';</script>
<style>
  .invoice-actions{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px}button{border:0;border-radius:6px;padding:12px 18px;background:#89cfff;color:#07182d;font:inherit;font-weight:600;cursor:pointer}button:disabled{opacity:.5}.invoice-paper{max-width:1000px;margin:auto;border:1px solid var(--border-color);background:var(--bg-card);border-radius:10px;padding:34px;overflow-wrap:anywhere}.invoice-heading{display:flex;justify-content:space-between;align-items:center;gap:28px;border-bottom:1px solid var(--border-color);padding-bottom:26px}.invoice-heading>div:last-child{text-align:right}h1{font-size:2rem;margin:0 0 8px}.invoice-heading p{margin:0 0 12px}.invoice-logo{position:relative;background:#000;width:310px;height:110px;max-width:100%;overflow:hidden;border-radius:6px;flex-shrink:0}.invoice-logo img{position:absolute;max-width:none;width:350px;height:auto;top:-57px;left:-18px}.paid-badge{display:inline-block;border:1px solid #2cae91;color:#87e5cd;border-radius:20px;padding:4px 14px;font-size:.8rem}.test-note{padding:14px;background:#493814;color:#ffe19c;border:1px solid #8d702b;border-radius:6px;margin:24px 0}.invoice-parties{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin:30px 0}.invoice-parties h2{font-size:.8rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px}.invoice-parties p{font-size:.85rem;margin:8px 0}.multiline{white-space:pre-line}.invoice-dates{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin:25px 0}dt{font-size:.8rem;color:var(--text-muted)}dd{margin:5px 0 0}.invoice-table{overflow:auto}table{border-collapse:collapse;width:100%;text-align:left}th{background:#001133;padding:13px 14px;font-size:.8rem;color:var(--text-muted)}th:last-child{text-align:right}:global(#invoice-lines td){padding:17px 14px;border-bottom:1px solid var(--border-color)}:global(#invoice-lines td:last-child){text-align:right;white-space:nowrap}.invoice-totals{max-width:360px;margin:24px 0 24px auto}.invoice-totals>div{display:flex;justify-content:space-between;gap:24px;padding:9px 0}.invoice-totals dt{font-size:1rem}.invoice-totals dd{margin:0}.balance{border-top:1px solid var(--border-color);font-weight:700}.invoice-footer{border-top:1px solid var(--border-color);padding-top:14px;font-size:.8rem;color:var(--text-muted)}@media(max-width:650px){.invoice-paper{padding:20px}.invoice-heading{flex-direction:column;align-items:flex-start}.invoice-heading>div:last-child{text-align:left}.invoice-logo{width:270px}.invoice-logo img{width:310px;top:-49px}.invoice-parties{grid-template-columns:1fr;gap:14px}.invoice-dates{grid-template-columns:1fr;gap:12px}.invoice-table{font-size:.8rem}th,:global(#invoice-lines td){padding:10px 7px}.invoice-actions{flex-wrap:wrap}}
  @media print{
    :global(body){background:white!important;color:#111!important;font:11pt/1.5 Arial,sans-serif!important}
    :global(.portal-header),:global(.portal-footer),:global(#dashboard-status),:global(#dashboard-logout-status),.invoice-actions,#invoice-status{display:none!important}
    :global(.container){max-width:none;margin:0;padding:0!important}.invoice-paper{max-width:none;border:0;border-radius:0;padding:0;background:white;color:#111}.invoice-heading{flex-direction:row;align-items:center}.invoice-heading>div:last-child{text-align:right}.invoice-logo{print-color-adjust:exact;-webkit-print-color-adjust:exact}.invoice-parties{grid-template-columns:1fr 1fr}.invoice-dates{grid-template-columns:1fr 1fr 1fr}dt,.invoice-parties h2,.invoice-footer{color:#444}.paid-badge{color:#075d49;border-color:#075d49}.test-note{background:white;color:#7d3b00;border-color:#7d3b00}th{background:#eee;color:#111;print-color-adjust:exact}tr{break-inside:avoid}.invoice-totals{break-inside:avoid}.invoice-footer a{display:none}a{color:#111;text-decoration:none}@page{size:A4;margin:16mm}
  }
</style>
