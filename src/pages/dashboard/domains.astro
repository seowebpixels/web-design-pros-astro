---
export const prerender=true;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---
<DashboardLayout title="My Domains | Web Design Pros" activeNav="domains">
  <header class="domain-heading"><div><h1>My Domains</h1><p>Your domain purchases and recorded registration details.</p></div><a href="/domains/">+ Register New Domain</a></header>
  <div class="domain-controls"><label>Orders <select id="domains-mode"><option value="test">Test purchases</option><option value="live">Live purchases</option></select></label><button id="domains-refresh" type="button">Refresh domains</button></div>
  <p id="domains-status" role="status" aria-live="polite">Loading your domains…</p>
  <div class="domain-table"><table><thead><tr><th>Domain name</th><th>Registration date</th><th>Expiry date</th><th>Status</th><th>Order</th></tr></thead><tbody id="domains-body"></tbody></table></div>
  <button id="domains-more" type="button" hidden>Load more orders</button>
</DashboardLayout>
<script>import '../../scripts/customer-domains';</script>
<style>
  .domain-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}h1{font-size:2rem;margin:0 0 12px}.domain-heading p{color:var(--text-muted)}.domain-heading>a,button{background:#89cfff;color:#07182d;border:0;border-radius:6px;padding:11px 17px;text-decoration:none;font:inherit;font-weight:700;cursor:pointer}.domain-controls{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin:25px 0}.domain-controls label{display:flex;align-items:center;gap:12px}select{font:inherit;background:#101b32;color:#fff;border:1px solid #4d617d;border-radius:6px;padding:10px}.domain-table{overflow:auto;border:1px solid var(--border-color);border-radius:8px}table{width:100%;border-collapse:collapse;text-align:left;min-width:750px}th{background:#001133;padding:16px;color:var(--text-muted);font-size:.75rem;text-transform:uppercase}:global(#domains-body td){padding:20px 16px;background:var(--bg-card);border-top:1px solid var(--border-color)}:global(#domains-body small){display:block;color:var(--text-muted);margin-top:6px;font-size:.75rem}#domains-more{margin:24px 0}button:disabled{opacity:.5}
</style>
