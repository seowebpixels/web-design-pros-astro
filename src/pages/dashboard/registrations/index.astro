---
export const prerender=true;
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---
<DashboardLayout title="Registration Queue | Web Design Pros" activeNav="registrations">
  <header class="queue-heading"><div><p class="eyebrow">WDP ADMINISTRATION</p><h1>Registration queue</h1><p>Paid domain orders, ready for your next step.</p></div><a class="th-link" href="https://truehost.cloud/" target="_blank" rel="noopener noreferrer">Open TrueHost ↗</a></header>
  <div class="queue-filters"><label>Orders<select id="queue-mode"><option value="test">Test purchases</option><option value="live">Live purchases</option></select></label><label>Show<select id="queue-filter"><option value="pending">Awaiting registration</option><option value="issue">Needs attention</option><option value="registered">Registration recorded</option><option value="all">All paid domains</option></select></label><button id="queue-refresh" type="button">Refresh queue</button></div>
  <p id="queue-notice" class="queue-notice">TEST PURCHASES · Practise recording details here. Do not buy these domains in TrueHost.</p>
  <p id="queue-status" role="status" aria-live="polite">Loading registration queue…</p>
  <div id="queue-items"></div><button id="queue-more" type="button" hidden>Load more orders</button>
</DashboardLayout>
<script>import '../../../scripts/registration-queue';</script>
<style is:global>
  .queue-heading{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap}.queue-heading h1{margin:8px 0 12px}.queue-heading p{color:var(--text-muted)}.queue-heading .eyebrow{font-size:.75rem;letter-spacing:2px;color:#89cfff}.th-link{padding:12px 18px;border:1px solid #536881;border-radius:7px;text-decoration:none}.queue-filters{display:flex;align-items:end;gap:16px;flex-wrap:wrap;margin:28px 0 20px}.queue-filters label,.registration-form label{display:grid;gap:7px;color:#b3c1d7;font-size:.85rem}.queue-filters select,.registration-form input,.registration-form select,.registration-form textarea{font:inherit;border:1px solid #4d617d;border-radius:6px;padding:11px 12px;background:#101b32;color:#fff;min-width:0;width:100%;color-scheme:dark}.queue-filters select{min-width:210px}.queue-filters button,.registration-form button,#queue-more{font:inherit;background:#89cfff;color:#07182d;border:0;border-radius:6px;padding:12px 20px;cursor:pointer;font-weight:700}button:disabled{opacity:.5;cursor:wait}.queue-notice{padding:14px 18px;background:#3a301b;border:1px solid #a87f33;border-radius:7px;color:#ffe1a0}.queue-empty{padding:40px;text-align:center;border:1px solid var(--border-color);border-radius:9px;color:var(--text-muted)}.registration-card{margin:24px 0;background:var(--bg-card);border:1px solid var(--border-color);border-radius:10px;overflow:hidden}.registration-top{padding:24px 26px;border-bottom:1px solid var(--border-color);display:flex;justify-content:space-between;align-items:start;gap:20px;flex-wrap:wrap}.registration-top h2{margin:5px 0 8px;font-size:1.5rem;overflow-wrap:anywhere}.registration-top p{margin:2px 0;color:var(--text-muted);font-size:.85rem}.registration-badge{padding:5px 12px;border-radius:20px;background:#09233c;color:#89cfff;font-size:.8rem;white-space:nowrap}.registration-details{padding:22px 26px;display:grid;grid-template-columns:1fr 1fr;gap:30px}.registration-details h3{font-size:1rem;margin:0 0 10px}.registration-details p{white-space:pre-line;overflow-wrap:anywhere;color:#c7d3e4;margin:4px 0}.registration-details small{color:#b3c1d7}.registration-form{border-top:1px solid var(--border-color);padding:24px 26px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.registration-form .wide{grid-column:1/-1}.registration-form textarea{resize:vertical;min-height:80px}.registration-form .registration-confirm{display:flex;align-items:start;gap:12px}.registration-confirm input{width:20px;height:20px;flex-shrink:0;margin:0}.registration-actions{display:flex;gap:18px;align-items:center;flex-wrap:wrap}.registration-message{margin:0;color:#b8ddff}.registration-card details{grid-column:1/-1}.registration-card summary{color:#89cfff;cursor:pointer}.registration-card .audit-entry{font-size:.8rem;color:var(--text-muted)}#queue-more{margin-top:10px}
  @media(max-width:700px){.registration-details,.registration-form{grid-template-columns:1fr}.registration-top,.registration-details,.registration-form{padding:20px}.queue-filters>label{width:100%}.queue-heading h1{font-size:2rem}}
</style>
