---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';

const localNeeds = [
  {
    icon: '✈️',
    title: 'Bookings Often Happen at the Last Minute',
    description: "Guesthouses, shuttle services and short-stay accommodation near the airport frequently take same-day or next-day bookings. A site that makes availability and contact details hard to find costs real bookings, not just traffic."
  },
  {
    icon: '📦',
    title: 'Logistics and Freight Clients Search With Specifics in Mind',
    description: "Businesses arranging freight, warehousing or courier services are usually looking for exact service details — capacity, turnaround, coverage area — rather than general reassurance. Vague copy tends to lose them before they enquire."
  },
  {
    icon: '📱',
    title: 'Mobile Search Comes First, Often From the Road',
    description: "A lot of Kempton Park's customer base is searching from a phone, sometimes en route or between flights. A site that's slow or awkward on mobile is a bigger handicap here than in a typical residential suburb."
  },
  {
    icon: '🕐',
    title: 'Trust Has to Be Established Quickly',
    description: "With less time for a customer to shop around or ask for a referral, a site needs to answer the obvious questions — what you do, where you are, how to reach you — without making the visitor dig for them."
  }
];
---

<Layout
  title="Web Design in Kempton Park | Web Design Pros"
  description="Web design for Kempton Park's airport-adjacent logistics, accommodation and trade businesses — built for customers who are deciding fast, often from a phone."
  canonical="https://webdesignpros.co.za/web-design-kempton-park"
>
  <section class="area-hero">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WEB DESIGN IN KEMPTON PARK</span>
        <h1 class="section-title">Web Design for Kempton Park's Airport-Adjacent Businesses</h1>
        <p class="section-intro">
          Kempton Park's position next to OR Tambo International Airport shapes a lot of its business fabric — logistics and freight operators, guesthouses and short-stay accommodation, shuttle and transport services, and trades that need to respond quickly. A website here often has to work for someone deciding in a hurry, not browsing at leisure.
        </p>
      </div>
    </div>
  </section>

  <section class="context-section">
    <div class="container">
      <div class="context-card">
        <h2>A Customer Base That's Often Short on Time</h2>
        <p>
          Businesses near an international airport deal with a particular kind of customer: someone booking accommodation the night before a flight, a company arranging freight collection against a deadline, a traveller needing a shuttle within the hour. None of that leaves much room for a slow site or unclear contact details — by the time a visitor has given up trying to find a phone number, they've usually already moved on to the next search result.
        </p>
      </div>
    </div>
  </section>

  <section class="needs-section">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WHAT THIS MEANS FOR YOUR SITE</span>
        <h2 class="section-title-h2">Built for Customers Who Are Deciding in a Hurry</h2>
      </div>
      <div class="needs-grid">
        {localNeeds.map((item) => (
          <div class="need-card">
            <div class="card-icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hypothetical-section">
    <div class="container">
      <div class="hypothetical-card">
        <span class="hypothetical-label">Illustrative example — not a real client case study</span>
        <h2>How We'd Approach a Kempton Park Shuttle or Accommodation Business</h2>
        <p>
          Picture a Kempton Park guesthouse or shuttle operator that relies almost entirely on travellers booking within a day or two of arrival, currently working from a listing on a booking platform and nothing else it controls directly. The priority wouldn't be a full online booking system — it would be a fast, mobile-first site that states availability, proximity to the airport, and a direct way to make contact, so a traveller deciding in the next ten minutes doesn't have to hunt for the basics.
        </p>
      </div>
    </div>
  </section>

  <section class="local-links-section">
    <div class="container">
      <p>
        See our <a href="/pricing">website packages and pricing</a>, browse <a href="/#portfolio">recent project work</a>, or view <a href="/#areas">all Gauteng areas we serve</a>.
      </p>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .area-hero {
    padding: 5rem 2rem 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .container {
    width: 100%;
  }

  .section-header {
    text-align: center;
    width: 100%;
    max-width: 850px;
    margin: 0 auto 3rem auto;
  }

  .sub-heading {
    color: var(--accent-secondary, #89CFF0);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .section-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    line-height: 1.15;
    white-space: normal;
  }

  .section-title-h2 {
    font-size: 2.25rem;
    color: #ffffff;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .section-intro {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.6;
    max-width: 750px;
    margin: 0 auto;
  }

  .context-section,
  .needs-section,
  .hypothetical-section {
    padding: 2rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .context-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .context-card h2 {
    font-size: 1.75rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .context-card p {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .needs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 1024px) {
    .needs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .need-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .need-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-primary, #0096FF);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .need-card h3 {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .need-card p {
    font-size: 0.875rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.55;
  }

  .hypothetical-card {
    background: rgba(0, 150, 255, 0.04);
    border: 1px solid rgba(0, 150, 255, 0.2);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .hypothetical-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--accent-secondary, #89CFF0);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .hypothetical-card h2 {
    font-size: 1.6rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .hypothetical-card p {
    font-size: 0.95rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .local-links-section {
    padding: 1rem 2rem 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .local-links-section p {
    font-size: 0.9rem;
    color: rgba(230, 230, 230, 0.7);
  }

  .local-links-section a {
    color: var(--accent-primary, #0096FF);
    text-decoration: underline;
  }

  .local-links-section a:hover {
    color: var(--accent-secondary, #89CFF0);
  }
</style>
