---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---
<Layout title="Checkout | Web Design Pros">
  <section class="checkout">
    <a href="/domains">← Continue domain search</a>
    <header><span class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</span><h1>Review & checkout</h1><p>Your domain, your details, one simple checkout.</p></header>
    <ol class="journey" aria-label="Checkout steps"><li>01 · Your cart</li><li>02 · Account & details</li><li>03 · Payment</li></ol>
    <p id="checkout-status" role="status" aria-live="polite"></p>
    <div id="empty" class="panel" hidden><h2>Your cart is waiting.</h2><p>Search for a domain and add it to your cart to get started.</p><a class="primary" href="/domains">Find your domain →</a></div>
    <div id="checkout-body" class="columns" hidden>
      <div>
        <section class="panel"><div class="heading"><h2>01 <span>Your cart</span></h2><a href="/domains">Add another domain</a></div><div class="cart-column-head"><span>Product / Options</span><span>Price / Cycle</span></div><div id="cart-items"></div><div class="cart-footer"><a href="/domains">Continue shopping →</a><button id="empty-cart" type="button" class="secondary">Empty cart</button></div><p class="muted">Choose 1–5 years. The selected price is the total due today.</p></section>
        <section class="panel recommendations"><h2>A little help getting started</h2><p class="muted">Optional services. Choose only what you need.</p><label class="check"><input type="checkbox" id="hosting" /><span><strong>Starter hosting</strong><small>Hosting for your website with email included · R60 / month</small></span></label><small>The first month of hosting is included in today's total. Hosting is billed monthly.</small></section>
        <form id="checkout-form">
          <section class="panel"><h2>02 <span>Account & billing details</span></h2><div id="account-choices" class="account-options"><label><input type="radio" name="account" value="new" checked /> I'm a new customer</label><label><input type="radio" name="account" value="existing" /> I already have an account</label></div><p id="account-note" class="muted">Create your account as part of checkout. When you continue, we will email you a link to verify your address before payment.</p>
            <div id="account-credentials" class="fields"><label>Email address<input name="email" type="email" autocomplete="email" required /></label><label>Password<input id="password" type="password" autocomplete="new-password" minlength="8" required /><small id="password-help">At least 8 characters</small></label></div>
            <button id="account-login" type="button" class="secondary" hidden>Login</button><button id="account-logout" type="button" class="secondary" hidden>Sign out</button><a class="account-help" href="/account/">Forgot password or need an account?</a><p id="login-status" role="status"></p>
            <fieldset id="billing-fields" class="fields billing" aria-label="New customer billing details">
              <label>First name<input name="firstName" autocomplete="given-name" required /></label><label>Last name<input name="lastName" autocomplete="family-name" required /></label>
              <label>Phone number<input name="phone" type="tel" autocomplete="tel" required /></label><label><span>Company <small>(optional)</small></span><input name="company" autocomplete="organization" /></label>
              <label class="wide">Street address<input name="address" autocomplete="street-address" required /></label><label>City<input name="city" autocomplete="address-level2" required /></label><label>Province / region<input name="province" autocomplete="address-level1" required /></label><label>Postal code<input name="postalCode" autocomplete="postal-code" required /></label><label>Country<input name="country" autocomplete="country-name" value="South Africa" required /></label>
            </fieldset>
          </section>
          <section class="panel"><h2>Domain registrant</h2><p class="muted">These details identify the legal owner of your domain.</p><label class="check"><input id="same-owner" type="checkbox" checked /><span id="owner-source">Use my billing details for the domain owner</span></label><fieldset id="owner-fields" class="fields" hidden disabled><legend>Domain owner details</legend><label>Full name<input name="ownerName" required /></label><label>Email<input name="ownerEmail" type="email" required /></label><label>Phone<input name="ownerPhone" type="tel" required /></label><label><span>Organisation <small>(optional)</small></span><input name="ownerCompany" /></label><label class="wide">Street address<input name="ownerAddress" required /></label><label>City<input name="ownerCity" required /></label><label>Province / region<input name="ownerProvince" required /></label><label>Postal code<input name="ownerPostalCode" required /></label><label>Country<input name="ownerCountry" value="South Africa" required /></label></fieldset></section>
          <section class="panel"><h2>03 <span>Review & pay</span></h2><div class="payment"><strong>Secure online payment</strong><span>Test mode</span></div><p class="muted">Review your order and accept the Terms of Service before continuing. Customer accounts are real. Payments are in test mode: use the provider’s test card. No money is charged and no domain is registered.</p><button class="primary" type="submit">Continue to payment →</button><p id="payment-status" role="status" aria-live="polite" tabindex="-1"></p></section>
        </form>
      </div>
      <aside class="summary-column"><div class="panel summary"><span class="eyebrow">ALL IN ONE PLACE</span><h2>Order summary</h2><div id="summary-items"></div><div class="total"><span>Total today</span><strong id="total"></strong></div><p class="muted">ZAR · No VAT charged.</p><hr /><p>Domain registration is subject to a final availability check.</p><a href="/contact">Need a hand? Talk to WDP →</a></div>
        <label class="check summary-terms"><input id="terms" name="terms" type="checkbox" form="checkout-form" required /><span>I have read and agree to the <a href="https://truehost.cloud/terms-of-service/" target="_blank" rel="noopener">Terms of Service</a></span></label>
      </aside>
    </div>
    <noscript>Please enable JavaScript to view your cart and continue with checkout.</noscript>
  </section>
</Layout>
<script>
  import '../scripts/checkout';
</script>
<style>
  #payment-status:not(:empty){padding:14px;border:1px solid #426085;border-radius:7px;background:#11203a;color:#d9ebff;overflow-wrap:anywhere;scroll-margin:140px}
  .checkout{max-width:1440px;margin:auto;padding:44px 24px 80px}a{color:#89cff0;text-underline-offset:4px}header{margin:35px 0 24px}header h1{text-align:left;margin:8px 0;font-size:clamp(2.4rem,5vw,3.2rem);letter-spacing:-2px;text-transform:none}header p,.muted,small{color:#b6c4d9}.eyebrow{color:#89cff0;font-size:.72rem;letter-spacing:2px;font-weight:700}.journey{display:flex;gap:30px;list-style:none;padding:26px 0;color:#89cff0;font-size:.85rem}.columns{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:24px;align-items:start}.panel{padding:28px;margin-bottom:20px;border:1px solid #35445f;border-radius:7px;background:#192743}.panel h2{font-size:1.35rem;margin-bottom:18px}.panel h2 span{margin-left:12px}.heading{display:flex;justify-content:space-between;gap:12px;align-items:baseline}.heading a{font-size:.8rem}.muted,small{font-size:.8rem}small{display:block}p{margin:12px 0}.fields{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:22px}.fields label{display:flex;flex-direction:column;align-self:start;gap:7px;font-size:.85rem}.fields label>span small{display:inline}.fields input{height:48px;flex-shrink:0}.wide{grid-column:1/-1}input:not([type=checkbox]):not([type=radio]){width:100%;min-width:0;padding:12px;background:#111d34;color:#fff;border:1px solid #4b5a74;border-radius:5px;font:inherit}input{accent-color:#0096ff}input:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid #89cff0;outline-offset:4px}.check{display:flex;gap:12px;align-items:flex-start;margin:18px 0;font-size:.85rem}.check input{margin-top:5px;width:17px;height:17px;flex-shrink:0}.account-options{display:flex;gap:20px;flex-wrap:wrap;font-size:.85rem}.recommendations{background:#17253c}.primary,.secondary{display:inline-block;padding:13px 20px;border-radius:7px;font:inherit;font-size:.9rem;font-weight:600;cursor:pointer;text-decoration:none}.primary{background:#0096ff;color:white;border:1px solid #0096ff}.secondary{background:transparent;border:1px solid #536b8b;color:#d9ebff}.primary:hover{background:#007bda}.payment{display:flex;justify-content:space-between;padding:18px;background:#11203a;border:1px solid #426085;border-radius:7px}.payment strong{font-size:1.5rem}.payment span{font-size:.8rem;align-self:center}.summary-column{position:sticky;top:110px}.summary-terms{margin:0 0 20px}.summary-terms input{width:20px;height:20px}.summary h2{margin-top:12px}.total{border-top:1px solid #40516b;margin-top:22px;padding-top:20px;display:flex;justify-content:space-between}.total strong{font-size:1.6rem;color:white}hr{border:0;border-top:1px solid #35445f;margin:22px 0}.summary p{font-size:.8rem}.summary a{font-size:.85rem}fieldset{border:0}legend{padding-top:15px}dialog{margin:auto;padding:32px;max-width:480px;width:calc(100% - 32px);border:1px solid #557494;border-radius:12px;background:#192743;color:white}dialog::backdrop{background:#060e20cc}.close{float:right;background:none;border:0;font-size:1.7rem;color:white;cursor:pointer}.payment-actions{display:grid;gap:12px;margin-top:24px}[hidden]{display:none!important}#checkout-status{color:#89cff0}
  .checkout :global(.cart-row){display:grid;grid-template-columns:minmax(0,1fr) 210px 36px;gap:20px;align-items:center;padding:26px 0;border-top:1px solid #35445f}.checkout :global(.cart-row strong){overflow-wrap:anywhere}.checkout :global(.remove){background:none;border:0;color:#89cff0;cursor:pointer;font:inherit;font-size:.8rem;text-decoration:underline}.checkout :global(.summary-row){display:flex;justify-content:space-between;gap:16px;font-size:.85rem;margin:16px 0;overflow-wrap:anywhere}.checkout :global(.summary-row span:first-child){min-width:0}
  @media(max-width:850px){.columns{grid-template-columns:1fr}.summary-column{position:static;grid-row:1}.journey{gap:14px;font-size:.7rem}.checkout{padding-top:32px}.panel{padding:20px}}@media(max-width:480px){.fields{grid-template-columns:1fr}.heading{display:block}.journey{flex-wrap:wrap}.checkout{padding-left:16px;padding-right:16px}.payment{gap:12px}}
.cart-column-head{display:grid;grid-template-columns:minmax(0,1fr) 266px;padding:10px 0 20px;color:#b6c4d9;font-size:.75rem}.cart-footer{display:flex;justify-content:space-between;align-items:center;gap:18px;border-top:1px solid #35445f;padding-top:20px}.cart-footer a{font-size:.8rem}.checkout :global(.cart-description strong){display:block;font-size:1rem}.checkout :global(.cart-description small){display:block;margin-top:6px;font-size:.78rem;color:#b6c4d9}.checkout :global(.cart-price select){width:100%;padding:11px 13px;border:1px solid #536780;border-radius:6px;background:#111d34;color:white;font:inherit;font-size:.85rem;cursor:pointer}.checkout :global(.cart-price small){display:block;color:#b6c4d9;font-size:.75rem;margin-top:8px;line-height:1.5}.checkout :global(.cart-price .term-included){color:#89cfff;font-size:.65rem;margin-top:4px}.checkout :global(.remove){display:grid;place-items:center;padding:8px;text-decoration:none;border-radius:5px}.checkout :global(.remove:hover){background:#32445e}@media(max-width:550px){.cart-column-head{display:none}.checkout :global(.cart-row){grid-template-columns:minmax(0,1fr) 36px;gap:16px}.checkout :global(.cart-description){grid-column:1}.checkout :global(.cart-price){grid-column:1/-1;grid-row:2}.checkout :global(.remove){grid-column:2;grid-row:1}.cart-footer{flex-wrap:wrap}}</style>
