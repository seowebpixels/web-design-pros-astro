---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';

const localNeeds = [
  {
    icon: '🔨',
    title: 'Home-Service Trades Are Chosen Under Pressure',
    description: "A burst geyser or a tripped circuit board doesn't wait for a referral. The trades that show up clearly in a quick local search win jobs that word of mouth alone would never reach in time."
  },
  {
    icon: '📋',
    title: 'Professional Practices Need to Look as Solid as They Are',
    description: "An established local accountant, attorney or advisor with decades of client trust can be quietly undercut by a thin or outdated website that doesn't reflect that experience to someone checking them out for the first time."
  },
  {
    icon: '📈',
    title: 'Owner-Managed Businesses Are Outgrowing Word of Mouth',
    description: "As a small business takes on more staff or a wider service area, referral alone stops being enough to keep the pipeline full — a website becomes less of a nice-to-have and more of a genuine growth requirement."
  },
  {
    icon: '📍',
    title: 'Being Findable Locally Still Matters Most',
    description: "For most Meyerton businesses, the goal isn't broad reach — it's showing up correctly and consistently when someone nearby searches for exactly what they offer."
  }
];
---

<Layout
  title="Web Design in Meyerton | Web Design Pros"
  description="Web design for Meyerton's local trades, professional practices and owner-managed businesses — built to reach further than word of mouth alone."
  canonical="https://webdesignpros.co.za/web-design-meyerton"
>
  <section class="area-hero">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WEB DESIGN IN MEYERTON</span>
        <h1 class="section-title">Web Design for Meyerton's Local Trades and Owner-Managed Businesses</h1>
        <p class="section-intro">
          Meyerton's economy leans on established local trades and home-service businesses, small professional practices, and a growing number of owner-managed businesses that have outgrown word-of-mouth alone. Different starting points, but most share the same gap: no real website, or one that hasn't kept pace with the business itself.
        </p>
      </div>
    </div>
  </section>

  <section class="context-section">
    <div class="container">
      <div class="context-card">
        <h2>A Town Where Reputation Still Travels by Word of Mouth — Mostly</h2>
        <p>
          In a smaller town like Meyerton, a plumber, electrician or accountant often still gets most new work through recommendation rather than online search. That's a real asset, but it has limits: word of mouth doesn't reach someone who's just moved to the area, doesn't help at nine o'clock at night when a geyser gives way, and doesn't do much for a business trying to grow past the ceiling personal referral eventually hits.
        </p>
      </div>
    </div>
  </section>

  <section class="needs-section">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WHAT THIS MEANS FOR YOUR SITE</span>
        <h2 class="section-title-h2">Built to Do What Word of Mouth Can't</h2>
      </div>
      <div class="needs-grid">
        {localNeeds.map((item) => (
          <div class="need-card">
            <div class="card-icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hypothetical-section">
    <div class="container">
      <div class="hypothetical-card">
        <span class="hypothetical-label">Illustrative example — not a real client case study</span>
        <h2>How We'd Approach a Meyerton Trade or Professional Practice</h2>
        <p>
          Word of mouth had carried a Meyerton electrician or bookkeeping practice for twenty years — right up until a newer arrival in town had nothing to go on but a search engine, and no way to find them at all. In a case like that, the fix isn't a marketing overhaul; it's a clear, accurate site that simply lets the reputation already built offline actually reach the people who haven't heard it yet.
        </p>
      </div>
    </div>
  </section>

  <section class="local-links-section">
    <div class="container">
      <p>
        See our <a href="/pricing">website packages and pricing</a>, browse <a href="/#portfolio">recent project work</a>, or view <a href="/#areas">all Gauteng areas we serve</a>.
      </p>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .area-hero {
    padding: 5rem 2rem 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .container {
    width: 100%;
  }

  .section-header {
    text-align: center;
    width: 100%;
    max-width: 850px;
    margin: 0 auto 3rem auto;
  }

  .sub-heading {
    color: var(--accent-secondary, #89CFF0);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .section-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    line-height: 1.15;
    white-space: normal;
  }

  .section-title-h2 {
    font-size: 2.25rem;
    color: #ffffff;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .section-intro {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.6;
    max-width: 750px;
    margin: 0 auto;
  }

  .context-section,
  .needs-section,
  .hypothetical-section {
    padding: 2rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .context-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .context-card h2 {
    font-size: 1.75rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .context-card p {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .needs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 1024px) {
    .needs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .need-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .need-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-primary, #0096FF);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .need-card h3 {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .need-card p {
    font-size: 0.875rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.55;
  }

  .hypothetical-card {
    background: rgba(0, 150, 255, 0.04);
    border: 1px solid rgba(0, 150, 255, 0.2);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .hypothetical-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--accent-secondary, #89CFF0);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .hypothetical-card h2 {
    font-size: 1.6rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .hypothetical-card p {
    font-size: 0.95rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .local-links-section {
    padding: 1rem 2rem 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .local-links-section p {
    font-size: 0.9rem;
    color: rgba(230, 230, 230, 0.7);
  }

  .local-links-section a {
    color: var(--accent-primary, #0096FF);
    text-decoration: underline;
  }

  .local-links-section a:hover {
    color: var(--accent-secondary, #89CFF0);
  }
</style>
