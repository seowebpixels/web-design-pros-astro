    {
      "title": "Creative that belongs to your brand",
      "description": "Prepare the agreed graphics, captions and formats using a consistent visual direction."
    },
    {
      "title": "An approval process",
      "description": "Review planned posts before publication, with responsibilities and turnaround times agreed."
    },
    {
      "title": "Useful performance reviews",
      "description": "Look at the agreed engagement and enquiry measures, then use the results to guide the next content cycle."
    }
  ],
  "steps": [
    {
      "title": "Set the direction",
      "description": "Identify your audience, channels, brand assets and content goals."
    },
    {
      "title": "Prepare and approve",
      "description": "Develop the content calendar and creative for your review."
    },
    {
      "title": "Publish and learn",
      "description": "Schedule approved content and review what resonates with your audience."
    }
  ],
  "faqs": [
    {
      "question": "Which platforms will you manage?",
      "answer": "We select platforms based on your audience and scope. The proposal lists the accounts, formats and number of posts included."
    },
    {
      "question": "Are paid adverts included?",
      "answer": "Paid campaign setup, management and advertising spend are separate unless explicitly included in your proposal."
    },
    {
      "question": "Will you reply to every message?",
