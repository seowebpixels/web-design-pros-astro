  "features": [
    "Content planning and scheduling",
    "Branded social creative",
    "Channel-specific messaging"
  ],
  "deliverables": [
    {
      "title": "A manageable content plan",
      "description": "Choose relevant themes, channels and a posting schedule that fits your business and available content."
