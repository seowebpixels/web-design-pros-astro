---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';

const localNeeds = [
  {
    icon: '🏭',
    title: 'Industrial Buyers Do Their Homework Before Calling',
    description: "A procurement contact or project manager sourcing a supplier or contractor typically checks a company's website before picking up the phone. If that site doesn't clearly show capability, certifications and scope, the enquiry often just goes elsewhere."
  },
  {
    icon: '🛠️',
    title: 'Technical Services Need to State Exactly What They Do',
    description: "Engineering, maintenance and technical service businesses are chosen on specifics — equipment handled, standards met, turnaround times — and vague, generic copy makes it harder for the right buyer to recognise a fit."
  },
  {
    icon: '🤝',
    title: 'Contractors Are Judged on Reliability, and a Site Can Signal That',
    description: "Clear project scope, accreditation and straightforward contact details do more to reassure a contractor's prospective client than broad claims about quality or service ever will."
  },
  {
    icon: '💼',
    title: 'Local Professional Practices Support the Same Industrial Base',
    description: "The accountants, attorneys and consultants serving Vanderbijlpark's industrial and contracting businesses are often chosen by similarly practical criteria — clarity, relevant experience and ease of contact, not marketing flourish."
  }
];
---

<Layout
  title="Web Design in Vanderbijlpark | Web Design Pros"
  description="Web design for Vanderbijlpark's industrial suppliers, technical services and contractors — built to make real capability easy for buyers to verify online."
  canonical="https://webdesignpros.co.za/web-design-vanderbijlpark"
>
  <section class="area-hero">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WEB DESIGN IN VANDERBIJLPARK</span>
        <h1 class="section-title">Web Design for Vanderbijlpark's Industrial and Technical Businesses</h1>
        <p class="section-intro">
          Vanderbijlpark's business fabric is still shaped by its industrial roots — suppliers, technical and engineering services, contractors, and the professional practices that support them. Many of these businesses have built their reputation on technical competence and reliability rather than marketing, and their websites often haven't caught up with that reality.
        </p>
      </div>
    </div>
  </section>

  <section class="context-section">
    <div class="container">
      <div class="context-card">
        <h2>Technical Credibility Matters More Than Polish</h2>
        <p>
          A Vanderbijlpark engineering supplier, contractor or technical service provider is usually judged on whether it can actually do the work — certifications, capability, track record — not on how slick its marketing looks. But a buyer or procurement contact still has to find that information somewhere before the first conversation happens, and a missing or outdated website makes a capable business look harder to verify than it should be.
        </p>
      </div>
    </div>
  </section>

  <section class="needs-section">
    <div class="container">
      <div class="section-header">
        <span class="sub-heading">WHAT THIS MEANS FOR YOUR SITE</span>
        <h2 class="section-title-h2">Built to Make Capability Easy to Verify</h2>
      </div>
      <div class="needs-grid">
        {localNeeds.map((item) => (
          <div class="need-card">
            <div class="card-icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hypothetical-section">
    <div class="container">
      <div class="hypothetical-card">
        <span class="hypothetical-label">Illustrative example — not a real client case study</span>
        <h2>How We'd Approach a Vanderbijlpark Technical Supplier or Contractor</h2>
        <p>
          A mid-sized Vanderbijlpark engineering supplier may have real capability and a strong reputation among people who already know the business, while remaining almost invisible to buyers outside that existing network. The gap usually isn't competence — it's that none of it is visible to someone who doesn't already know who to call. The right response is a straightforward site that sets out scope of work, certifications and past project types clearly enough for an unfamiliar buyer to shortlist the business with confidence.
        </p>
      </div>
    </div>
  </section>

  <section class="local-links-section">
    <div class="container">
      <p>
        See our <a href="/pricing">website packages and pricing</a>, browse <a href="/#portfolio">recent project work</a>, or view <a href="/#areas">all Gauteng areas we serve</a>.
      </p>
    </div>
  </section>

  <CTA />
</Layout>

<style>
  .area-hero {
    padding: 5rem 2rem 1rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .container {
    width: 100%;
  }

  .section-header {
    text-align: center;
    width: 100%;
    max-width: 850px;
    margin: 0 auto 3rem auto;
  }

  .sub-heading {
    color: var(--accent-secondary, #89CFF0);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .section-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    line-height: 1.15;
    white-space: normal;
  }

  .section-title-h2 {
    font-size: 2.25rem;
    color: #ffffff;
    margin-top: 0.5rem;
    margin-bottom: 0;
  }

  .section-intro {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.6;
    max-width: 750px;
    margin: 0 auto;
  }

  .context-section,
  .needs-section,
  .hypothetical-section {
    padding: 2rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .context-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .context-card h2 {
    font-size: 1.75rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .context-card p {
    font-size: 1rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .needs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 1024px) {
    .needs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .need-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .need-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-primary, #0096FF);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .need-card h3 {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .need-card p {
    font-size: 0.875rem;
    color: rgba(230, 230, 230, 0.8);
    line-height: 1.55;
  }

  .hypothetical-card {
    background: rgba(0, 150, 255, 0.04);
    border: 1px solid rgba(0, 150, 255, 0.2);
    border-radius: 16px;
    padding: 2.5rem;
  }

  .hypothetical-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--accent-secondary, #89CFF0);
    background: rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .hypothetical-card h2 {
    font-size: 1.6rem;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .hypothetical-card p {
    font-size: 0.95rem;
    color: rgba(230, 230, 230, 0.85);
    line-height: 1.65;
  }

  .local-links-section {
    padding: 1rem 2rem 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .local-links-section p {
    font-size: 0.9rem;
    color: rgba(230, 230, 230, 0.7);
  }

  .local-links-section a {
    color: var(--accent-primary, #0096FF);
    text-decoration: underline;
  }

  .local-links-section a:hover {
    color: var(--accent-secondary, #89CFF0);
  }
</style>
